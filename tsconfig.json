{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  // `design/` es el lienzo aprobado (HTML, capturas y los scripts de sus
  // herramientas): material de consulta, no código del sitio. Se excluye para que
  // `astro check` —que es parte de la puerta del build— hable solo del código vivo
  // y sus avisos signifiquen algo.
  "exclude": ["dist", "design"],
  "compilerOptions": {
    "strictNullChecks": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    }
  }
}
