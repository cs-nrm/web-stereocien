---
/**
 * La nota. Mínima pero correcta: titular, balazo, firma, fecha, la foto y el
 * cuerpo. El diseño aprobado dibuja solo el Inicio, así que esta página no tiene
 * tablero propio: usa las mismas piezas (tipografía, antetítulos, esquina recta) y
 * nada que el diseño no haya dicho. Sin anuncios y sin compartir por ahora.
 *
 * La URL es PLANA —`/noticias/<slug>`, no `/<sección>/<slug>`—, que es el contrato
 * decidido por Carlos y lo que el CMS emite en `getNewsURL`. Las ~1,008 notas del
 * sitio viejo, que viven en `/<sección>/<slug>/`, llegan aquí con un 301 del mapa
 * que consulta el middleware.
 *
 * Toda la lógica de datos e indexación se porta de web-beat tal cual —el 503 si
 * el CMS no responde, el 404 real, el grupo `meta` del CMS, el `X-Robots-Tag`, el
 * JSON-LD—, porque es lo que allá ya se pagó.
 */
import Base from '@/layouts/Base.astro';
import Lexical from '@/components/Lexical.astro';
import TarjetaNota from '@/components/TarjetaNota.astro';
import { obtenerNota, obtenerRelacionadas } from '@/lib/cms/noticias';
import { medidaMedia, puntoFocal, urlMedia } from '@/lib/cms/client';
import { fechaCorta, fechaIso, firma, nombreCategoria, seccionDeNota } from '@/lib/nota';
import { SITE_URL, rutaNota, urlAbsoluta } from '@/config/site';
import { nodoMigaja, nodoNota, serializar } from '@/lib/jsonld';

const { slug } = Astro.params;

let nota = null;
try {
  nota = slug ? await obtenerNota(slug) : null;
} catch {
  // Heredado de web-beat: si el CMS no responde no se puede saber si la nota
  // existe. Un 404 sería una mentira cacheable; un 503 es la verdad y no se indexa.
  return new Response('El CMS no responde. Vuelve a intentarlo en un momento.', {
    status: 503,
    headers: { 'cache-control': 'no-store', 'retry-after': '30' },
  });
}

/*
  El 404 REAL: se reescribe a la página de error, que responde con estado 404 y
  el cascarón completo (heredado de web-beat, que lo hace así en todas sus rutas
  dinámicas). Una nota que no existe no puede responder 200 con una página vacía:
  Google la indexaría como contenido.
*/
if (!nota || !nota.slug) return Astro.rewrite('/404');

/*
  Las tres relacionadas del pie, por categoría. `obtenerRelacionadas` excluye la
  nota actual EN MEMORIA para que todas las notas de una categoría compartan una
  sola entrada de caché, y degrada a `[]` si el CMS falla. Sin categorías no
  consulta nada.
*/
const relacionadas = await obtenerRelacionadas(nota, 3);

const canonica = new URL(rutaNota(nota.slug), SITE_URL).href;
const autor = firma(nota);
const publicada = fechaCorta(nota.fecha ?? nota.createdAt);
const publicadaIso = fechaIso(nota.fecha ?? nota.createdAt);
/*
  `updatedAt` lo mueve el CMS en cada guardado, así que puede ser posterior a la
  fecha que se ve. No es una contradicción: la visible es cuándo se publicó y esta,
  cuándo se tocó por última vez. Google usa las dos.
*/
const modificadaIso = fechaIso(nota.updatedAt);

/*
  La migaja: el Inicio y, si la nota es de una sección del diseño, la sección.
  La sección la decide la categoría (`seccionDeNota`); una nota de una categoría
  sin sección —Series y películas, Tecnología…— se queda con la categoría como
  texto, sin enlace, porque todavía no tiene a dónde ir.
*/
const seccion = seccionDeNota(nota);
const categoria = nombreCategoria(nota);

const media = nota.imagen && typeof nota.imagen === 'object' ? nota.imagen : null;
const hero = urlMedia(media, 'large');
/*
  Las medidas se piden POR LA URL que `urlMedia` acabó eligiendo, no por la
  variante pedida: `large` puede no existir y entonces `hero` es `card`. Sin las
  dos medidas, `null`, y ni el `<img>` ni las etiquetas inventan unas.
*/
const heroMedida = medidaMedia(media, hero);
const heroAlt = media?.alt ?? '';
const heroEnfoque = puntoFocal(media);

/**
 * EL GRUPO `meta` DEL CMS (heredado de web-beat, decisiones de Carlos del
 * 2026-09-07). Es la ficha que la redacción captura para buscadores y para lo que
 * se comparte, y existe para poder decir las cosas de otra manera AHÍ.
 *
 * Cada campo se toma solo si trae algo (`?.trim() ||`, no `??`): un campo que se
 * abrió y se dejó en blanco llega como cadena vacía, y con `??` ganaría y la nota
 * se compartiría sin titular.
 *
 * Lo que NO cambia es el `h1`, la bajada ni el JSON-LD: esos dicen lo que hay en
 * la página.
 */
const meta = nota.meta ?? {};
const tituloMeta = meta.title?.trim() || nota.titulo;
const resumenMeta = meta.description?.trim() || nota.resumen || undefined;

/*
  `meta.canonicalUrl` se IGNORA, y no es un olvido (heredado de web-beat): toda
  URL de este sitio se arma contra `SITE_URL`. Honrarlo le daría a un campo de
  texto del admin la capacidad de sacar una nota del índice de este dominio sin
  que se note en ninguna pantalla. El día que la estación republique contenido de
  terceros, es una decisión que se toma de nuevo.
*/

/*
  La foto con la que se COMPARTE: `meta.image` si existe, y si no la de la nota.
  El `alt` y las medidas viajan CON la foto elegida, nunca mezclados.
*/
const social = urlMedia(meta.image, 'large');
const socialAlt = meta.image && typeof meta.image === 'object' ? (meta.image.alt ?? null) : null;
const compartida = social ?? hero;
const compartidaAlt = social ? socialAlt : heroAlt || null;
const compartidaMedida = social ? medidaMedia(meta.image, social) : heroMedida;

/**
 * `meta.noIndex` se HONRA en las dos capas que pueden saberlo: aquí la cabecera
 * y en `Base.astro` el `<meta robots>`. El middleware no puede: cuando corre no sabe
 * qué documento se va a servir. Y va en el frontmatter de la PÁGINA porque desde el
 * layout la respuesta ya está en camino y las cabeceras, decididas.
 */
const noIndex = meta.noIndex === true;
if (noIndex) Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow');

/**
 * Los datos estructurados: `NewsArticle` y la migaja, en un solo `@graph`.
 *
 * Cada valor es EL MISMO que ya pinta la página: el titular, la bajada, el ISO del
 * `<time>` visible, la firma, la variante de foto que carga el `<img>`. Aquí no
 * entra el grupo `meta` —un `headline` que no sea el `h1` visible es marcado
 * engañoso—.
 *
 * La migaja del JSON-LD es la visible MENOS la sección, a propósito: hoy la
 * sección enlaza a su ancla del Inicio (`/#lado-a`), y un eslabón que apunte a la
 * misma página que «Inicio» no le dice nada a un buscador. Omitir un eslabón no
 * afirma nada falso; el día que la sección tenga página propia, entra.
 */
const pasoSeccion =
  seccion && !seccion.href.includes('#')
    ? [{ nombre: seccion.nombre, url: urlAbsoluta(seccion.href) }]
    : [];
const ficha = serializar(
  [
    nodoNota({
      canonica,
      titulo: nota.titulo,
      resumen: nota.resumen,
      imagen: hero,
      imagenAncho: heroMedida?.ancho,
      imagenAlto: heroMedida?.alto,
      publicado: publicadaIso,
      modificado: modificadaIso,
      autor: autor?.nombre,
    }),
    nodoMigaja([
      { nombre: 'Inicio', url: urlAbsoluta('/') },
      ...pasoSeccion,
      { nombre: nota.titulo, url: canonica },
    ]),
  ].filter((n): n is NonNullable<typeof n> => n !== null),
);
---

<Base
  titulo={`${tituloMeta} — Stereo Cien 100.1`}
  descripcion={resumenMeta}
  imagen={compartida}
  imagenAlt={compartidaAlt}
  imagenAncho={compartidaMedida?.ancho}
  imagenAlto={compartidaMedida?.alto}
  noIndex={noIndex}
  tipo="article"
  publicado={publicadaIso}
  modificado={modificadaIso}
>
  {/*
    guarda-ok set:html: JSON-LD, que en Astro no tiene otra forma de emitirse. El
    valor lo arma `serializar()` y no es HTML del CMS: es JSON con `<` escapado,
    para que un `</script>` dentro de un titular no cierre el bloque. Ver
    `src/lib/jsonld.ts`.
  */}
  <script type="application/ld+json" is:inline set:html={ficha} />

  <article class="nota">
    <header class="nota-cabeza">
      <nav class="nota-migaja" aria-label="Ruta de navegación">
        <ol>
          <li><a href="/">Inicio</a></li>
          {
            seccion ? (
              <li>
                <a href={seccion.href}>{seccion.nombre}</a>
              </li>
            ) : (
              categoria && <li>{categoria}</li>
            )
          }
        </ol>
      </nav>
      <h1 class="nota-titulo">{nota.titulo}</h1>
      {nota.resumen && <p class="nota-balazo">{nota.resumen}</p>}
      {
        (autor || publicada) && (
          <p class="nota-credito">
            {autor && <span>por {autor.nombre}</span>}
            {publicada && <time datetime={publicadaIso ?? undefined}>{publicada}</time>}
          </p>
        )
      }
    </header>

    {
      hero && (
        <figure class="nota-foto">
          <img
            src={hero}
            alt={heroAlt}
            width={heroMedida?.ancho}
            height={heroMedida?.alto}
            style={heroEnfoque ? `object-position: ${heroEnfoque}` : undefined}
            fetchpriority="high"
            decoding="async"
          />
        </figure>
      )
    }

    {/*
      El cuerpo. Se estiliza el CONTENEDOR (`.prosa`, en `src/styles/prosa.css`),
      no las clases internas de Lexical: el texto se ve igual venga del nodo que
      venga. Lexical saca el texto COMO TEXTO; nada de `set:html` con contenido del
      CMS.
    */}
    <div class="nota-cuerpo prosa">
      <Lexical contenido={nota.contenido} />
    </div>
  </article>

  {
    relacionadas.length > 0 && (
      <section class="nota-relacionadas" aria-labelledby="titulo-relacionadas">
        <h2 class="nota-relacionadas-titulo" id="titulo-relacionadas">
          Sigue leyendo
        </h2>
        <ul class="nota-relacionadas-lista">
          {relacionadas.map((n) => (
            <li>
              <TarjetaNota nota={n} variante="fila" nivel={3} />
            </li>
          ))}
        </ul>
      </section>
    )
  }
</Base>

<style>
  /* Una columna de lectura, centrada en la revista: 760 px con sus márgenes. */
  .nota,
  .nota-relacionadas {
    box-sizing: content-box;
    max-width: 760px;
    margin: 0 auto;
    padding-inline: var(--margen-revista);
  }
  .nota {
    padding-top: 56px;
  }

  .nota-migaja ol {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 10px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-family: var(--font-display);
    font-weight: 900;
    font-size: var(--text-etiqueta);
    line-height: var(--text-etiqueta--line-height);
    letter-spacing: var(--tracking-etiqueta);
    text-transform: uppercase;
    color: var(--color-azul-principal);
  }
  .nota-migaja li + li::before {
    content: '/';
    margin-right: 10px;
    color: var(--color-gris-texto);
  }
  .nota-migaja a:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .nota-titulo {
    margin: 16px 0 0;
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(40px, 3.4vw, 60px);
    line-height: 0.95;
    letter-spacing: var(--tracking-titular);
    text-transform: uppercase;
    text-wrap: balance;
    overflow-wrap: break-word;
  }
  .nota-balazo {
    margin: 18px 0 0;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 24px;
    line-height: 34px;
    text-wrap: pretty;
  }
  .nota-credito {
    margin: 20px 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 4px 16px;
    font-size: var(--text-etiqueta);
    line-height: var(--text-etiqueta--line-height);
    font-weight: 700;
    color: var(--color-gris-texto);
  }
  .nota-credito time {
    letter-spacing: var(--tracking-titular);
  }

  /* La foto en esquina recta y a todo el ancho de la columna, en su proporción. */
  .nota-foto {
    margin: 32px 0 0;
  }
  .nota-foto img {
    display: block;
    width: 100%;
    height: auto;
    background-color: #dfe3ea;
  }

  .nota-cuerpo {
    margin-top: 40px;
  }

  .nota-relacionadas {
    padding-top: 72px;
    padding-bottom: 24px;
  }
  .nota-relacionadas-titulo {
    margin: 0;
    padding-bottom: 12px;
    border-bottom: 2px solid var(--color-negro);
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 14px;
    line-height: 18px;
    letter-spacing: var(--tracking-etiqueta);
    text-transform: uppercase;
  }
  .nota-relacionadas-lista {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (max-width: 1279px) {
    .nota {
      padding-top: 28px;
    }
    .nota-titulo {
      margin-top: 12px;
      font-size: 32px;
    }
    .nota-balazo {
      margin-top: 12px;
      font-size: 18px;
      line-height: 27px;
    }
    .nota-foto {
      margin-top: 20px;
    }
    .nota-cuerpo {
      margin-top: 28px;
    }
    .nota-relacionadas {
      padding-top: 48px;
    }
  }
</style>
