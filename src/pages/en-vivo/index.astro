---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../../consts";
import { Tabs } from "astro-tabs";
import BarNrm from "../../components/BarNrm.astro";
---

<BaseLayout title="En Vivo" description={SITE_DESCRIPTION}>
    <BarNrm />
    <Header title={SITE_TITLE} />

    <main id="envivo">
        <div class="mx-auto">
            <div class="md:flex md:flex-col lg:flex-row">
                <div class="banner-prog">
                    <img src="" />
                </div>
                <div class="info-envivo">
                    <div class="envivo-prog"></div>
                    <div class="envivo-loc"></div>
                    <div class="envivo-desc"></div>
                </div>
            </div>

            <div class="programas">
                <div class="prog-now">
                    <div class="envivo-title">
                        En vivo: <span class="envivo-now"></span>
                    </div>
                    <div class="envivo-prog-tab"></div>
                    <div class="envivo-loc-tab"></div>
                </div>

                <div class="prog-next">
                    <div class="siguiente-title">
                        Siguiente: <span class="envivo-next"></span>
                    </div>
                    <div class="envivo-prog-next-tab"></div>
                    <div class="envivo-loc-next-tab"></div>
                </div>

                <div class="prog-all">
                    <svg
                        xmlns="https://www.w3.org/2000/svg"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        width="28"
                        height="28"
                        stroke-width="1"
                    >
                        <path
                            d="M10.5 21h-4.5a2 2 0 0 1 -2 -2v-12a2 2 0 0 1 2 -2h12a2 2 0 0 1 2 2v3"
                        ></path>
                        <path d="M16 3v4"></path>
                        <path d="M8 3v4"></path>
                        <path d="M4 11h10"></path>
                        <path d="M18 18m-4 0a4 4 0 1 0 8 0a4 4 0 1 0 -8 0"
                        ></path>
                        <path d="M18 16.5v1.5l.5 .5"></path>
                    </svg>
                    <a href="/programacion"
                        ><span>Ver toda la programación</span></a
                    >
                </div>
            </div>
        </div>
    </main>
    <Footer />
</BaseLayout>

<style>
    .programas {
        display: flex;
        width: 100%;
        font-family: "Roboto";
    }
    .prog-now {
        width: 33%;
        padding: 20px;
        background: #201e1e;
        border-top-right-radius: 20px;
    }
    .prog-next {
        width: 33%;
        padding: 20px;
        border-right: 1px solid white;
    }
    .prog-all {
        width: 34%;
        padding: 20px;
        display: flex;
        gap: 25px;
        color: #201e1e;
    }
    .prog-all div {
        display: flex;
        gap: 10px;
    }
    .prog-all a {
        color: #e94543;
    }
    .banner-prog {
        width: 25%;
        padding: 20px;
        max-width: 550px;
    }
    .banner-prog img {
        object-fit: cover;
        border-radius: 163%;
        width: 100%;
        height: auto;
    }
    .envivo-prog {
        font-size: 2.5rem;
        color: #201e1e;
        font-family: "Roboto";
    }
    .envivo-prog-tab {
        color: #d6d8d7;
    }
    .envivo-prog-next-tab {
        color: #201e1e;
    }
    .info-envivo {
        padding: 40px;
    }
    .envivo-title,
    .siguiente-title {
        color: #e94543;
        font-weight: bold;
        font-size: 85%;
    }
    .envivo-title span,
    .siguiente-title span {
        color: #201e1e;
        font-weight: normal;
    }

    @media (max-width: 768px) {
        .programas {
            display: block;
        }
        .banner-prog {
            width: 100%;
            justify-content: center;
            display: flex;
            margin: 0 auto;
        }
        .banner-prog img {
        }
        .info-envivo {
            display: none;
        }
        .prog-now {
            width: 100%;
        }
        .prog-next {
            width: 100%;
        }
        .prog-all {
            width: 100%;
            padding: 20px;
            gap: 10px;
        }
        .prog-all div {
            width: 100%;
            padding: 10px;
            background: #201e1e;
            border-radius: 20px;
        }
        .volume {
            display: none !important;
        }
    }
</style>
<script>
    $(".logo-player img").attr("src", "/img/logo-STEREO-pag.png");
    $("#big-play").removeClass("border-4");

    $(".like").on("click", function () {
        console.log("click");
        $(this).find("svg").css("fill", "#d6d8d7");
    });
</script>
