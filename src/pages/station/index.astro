---
import { ClientRouter } from 'astro:transitions';
import BaseLayout from "../../layouts/BaseLayout.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../../consts.js";
import { getArticles } from "../../lib/api.js";
import SliderStation from '../../layouts/SliderStation.astro';
//import Player from '../../components/Player.astro';
//const currentPath = Astro.url.pathname;


export async function getStaticPaths({ paginate }) {
	const data = await getArticles(524);
	return paginate(data, { pageSize: 10 });
}

interface Props {
	page: any;
}

const { page = [] } = Astro.props;
//console.log(page.data);
---

<BaseLayout title="Sounds" description={SITE_DESCRIPTION}>

	<ClientRouter />
	<main>
		<div class="container my-12 mx-auto px-4 md:px-12">
			<div class="">
				<SliderStation />
			</div>
		</div>
	</main>
</BaseLayout>
