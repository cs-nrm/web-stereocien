  }

  .sr-controls {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 24px;
    margin-top: 20px;
  }

  .sr-iconbtn {
    width: 52px;
    height: 52px;
    border-radius: 999px;
    border: 0;
    background: transparent;
