  .sr-play {
    width: 96px;
    height: 96px;
    border-radius: 999px;
    border: 0;
    background: #fff;
    color: #000;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    box-shadow: 0 15px 40px rgba(255, 255, 255, 0.15);
    transition: transform 0.15s;
  }
  .sr-play:hover {
    transform: scale(1.05);
