    flex-direction: column;
    align-items: center;
    gap: 18px;
  }

  .sr-pill {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 14px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.06);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
  }

  .sr-eqdot {
    width: 10px;
    height: 10px;
    border-radius: 999px;
    background: #1773cf;
    opacity: 0.9;
  }
  .sr-eqdot.is-playing {
    animation: eqPulse 1.2s ease-in-out infinite;
  }

  @keyframes eqPulse {
    0% {
      transform: scale(0.85);
      opacity: 0.55;
    }
    50% {
      transform: scale(1.15);
      opacity: 1;
    }
    100% {
      transform: scale(0.85);
      opacity: 0.55;
    }
  }

  .sr-pilltext {
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.15em;
    color: rgba(255, 255, 255, 0.4);
  }

  .sr-handle {
    width: 128px;
    height: 6px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.1);
  }

  .sr-spinner {
    width: 42px;
    height: 42px;
    border-radius: 999px;
    border: 4px solid rgba(0, 0, 0, 0.18);
    border-top-color: rgba(0, 0, 0, 0.8);
    animation: srSpin 0.9s linear infinite;
  }

  @keyframes srSpin {
    to {
      transform: rotate(360deg);
    }
  }

  .sr-hidden {
    display: none !important;
  }

  @media only screen and (min-width: 768px) {
    .sr-player {
      width: 100%;
      max-width: 500px;
    }
  }
</style>
