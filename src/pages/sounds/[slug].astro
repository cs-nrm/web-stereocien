                    <!-- Botón play/pause blanco con ícono azul --
                    <button class="play-pause-btn" data-station="noche-de-paz">
                        <i class="fas fa-play play-icon"></i>
                        <i class="fas fa-pause pause-icon"></i>
                    </button>
                    
                    <div class="playing-indicator">
                        <div class="pulse-dot"></div>
                        <span>En vivo</span>
                    </div>
                </div-->
                
                <!-- Tarjeta Cono Navideño -->
                <div class="music-card" id="cono-navideno">
                    <!--i class="fas fa-tree card-icon"></i-->
                    <h3>Christmas Sounds</h3>
                    
                    <!-- Botón play/pause blanco con ícono azul -->
                    <button class="play-pause-btn" data-station="cono-navideno">
