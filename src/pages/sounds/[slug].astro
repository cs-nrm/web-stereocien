        .music-card.active {
            border-color: #cf6fea;
            background: rgba(15, 3, 197, 0.95);
            box-shadow: 0 0 25px rgba(255, 209, 102, 0.4);
            transform: translateY(-5px);
        }

        /* Íconos de las tarjetas */
        .card-icon {
            font-size: 3rem;
            color: #cf6fea;
            margin-bottom: 1rem;
            transition: transform 0.3s, color 0.3s;
        }

        .music-card.active .card-icon {
