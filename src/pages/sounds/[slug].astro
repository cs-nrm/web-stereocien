        }

        /* Botón play/pause actualizado - Blanco con ícono azul */
        .play-pause-btn {
            width: 100px;
            height: 100px;
            border-radius: 50%;
            background: #FFFFFF;
            border: none;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all 0.3s ease;
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.2);
            position: relative;
            margin-top: 0.5rem;
        }

        .play-pause-btn:hover {
            transform: scale(1.1);
            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.25);
        }

        .play-pause-btn.playing {
            background: #FFFFFF;
            box-shadow: 0 0 20px rgba(255, 255, 255, 0.5);
        }

        .play-icon {
            padding-left: 5px;
        }

        .play-pause-btn .play-icon,
        .play-pause-btn .pause-icon {
            font-size: 2.5rem;
            color: #0f03c5;
            transition: opacity 0.3s;
        }

        .play-pause-btn .play-icon {
            opacity: 1;
        }

        .play-pause-btn .pause-icon {
            opacity: 0;
            position: absolute;
        }

        .play-pause-btn.playing .play-icon {
            opacity: 0;
        }

        .play-pause-btn.playing .pause-icon {
            opacity: 1;
        }

        /* Indicador de reproducción */
        .playing-indicator {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            margin-top: 1rem;
            font-size: 0.9rem;
