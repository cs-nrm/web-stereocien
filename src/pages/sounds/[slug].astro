    </main>
    
    <!-- Reproductor de radio -->
    <div class="radio-player" id="radio-player" style="display: none;">

        <div class="player-artwork">
            <img id="artwork" src="" width="50"/>
        </div>

        <div class="player-controls">
            <button class="player-btn" id="play-pause-btn">
                <i class="fas fa-play"></i>
            </button>
            <button class="player-btn" id="stop-btn">
                <i class="fas fa-stop"></i>
            </button>
        </div>
        <div class="player-info">
            <div class="station-name" id="current-station">Selecciona una estación</div>
            <div class="player-status" id="player-status">Detenido</div>
        </div>
        <div class="volume-control">
            <i class="fas fa-volume-up" style="color: #034dc5;"></i>
            <input type="range" class="volume-slider" id="volume-slider" min="0" max="1" step="0.1" value="0.7">
        </div>
    </div>
</div>

    <script is:inline define:vars={{streamurl}}>
        console.log("Stream URL:", streamurl);
        // ========== CONFIGURACIÓN DE ESTACIONES DE RADIO ==========
        const radioStations = {
            "noche-de-paz": {
                name: "Noche de Paz Radio",
                url: {streamurl},
                description: "Clásicos navideños las 24 horas",
                artworkUrl: "logo-sounds.png"
            },
            "cono-navideno": {
                name: "Christmas Sounds",
                url: {streamurl},
                description: "Música alegre para toda la familia",
                artworkUrl: "logo-sounds.png"
            }
        };
        
        // ========== VARIABLES GLOBALES ==========
        let audioPlayer = null;
        let currentStation = null;
        let isPlaying = false;
        let volume = 0.7;
        
        // ========== INICIALIZACIÓN ==========
        document.addEventListener('DOMContentLoaded', function() {
            initializeRadioPlayer();
            setupEventListeners();
        });
        
        // ========== REPRODUCTOR DE RADIO ==========
        function initializeRadioPlayer() {
            audioPlayer = new Audio();
            audioPlayer.volume = volume;
            audioPlayer.preload = 'none';
            
            audioPlayer.addEventListener('playing', function() {
                updatePlayerStatus('Reproduciendo...');
                updatePlayPauseButton(true);
                showPlayingIndicator(currentStation, true);
                updateCardButton(currentStation, true);
            });
            
            audioPlayer.addEventListener('pause', function() {
                updatePlayerStatus('Pausado');
                updatePlayPauseButton(false);
                showPlayingIndicator(currentStation, false);
                updateCardButton(currentStation, false);
            });
            
            audioPlayer.addEventListener('waiting', function() {
                updatePlayerStatus('Cargando...');
            });
            
            audioPlayer.addEventListener('error', function(e) {
                console.error('Error de audio:', e);
                updatePlayerStatus('Error al cargar la radio');
                resetPlayer();
                //alert('No se pudo conectar a la radio. Verifica la URL o intenta con otra estación.');
            });
            
            audioPlayer.addEventListener('canplay', function() {
                updatePlayerStatus('Listo para reproducir');
            });
        }
        
        // ========== FUNCIONES PRINCIPALES ==========
        function playStation(stationId) {
            if (currentStation === stationId && isPlaying) {
                pauseRadio();
                return;
            }
            
            if (currentStation && currentStation !== stationId) {
                stopRadio();
            }
            
            const station = radioStations[stationId];
            if (!station) {
                alert('Estación no encontrada');
                return;
            }
            
            currentStation = stationId;
            audioPlayer.src = station.url;
            
            document.getElementById('radio-player').style.display = 'flex';
            document.getElementById('current-station').textContent = station.name;
            document.getElementById('artwork').src = station.artworkUrl;
            updatePlayerStatus('Conectando...');
            
            highlightActiveCard(stationId);
            
            audioPlayer.play()
                .then(() => {
                    isPlaying = true;
                    updatePlayerStatus('Reproduciendo...');
                    updatePlayPauseButton(true);
                    updateCardButton(stationId, true);
                    showPlayingIndicator(stationId, true);
                })
                .catch(error => {
                    console.error('Error al reproducir:', error);
                    updatePlayerStatus('Error: ' + error.message);
                    
                    if (error.name === 'NotAllowedError') {
                        alert('Haz clic en el botón de reproducción en el reproductor para iniciar la radio.');
                        updatePlayerStatus('Haz clic en ▶ para reproducir');
                    }
                });
        }
        
        function pauseRadio() {
            if (audioPlayer && !audioPlayer.paused) {
                audioPlayer.pause();
                isPlaying = false;
                updatePlayerStatus('Pausado');
                updatePlayPauseButton(false);
                showPlayingIndicator(currentStation, false);
                updateCardButton(currentStation, false);
            }
        }
        
        function stopRadio() {
            if (audioPlayer) {
                audioPlayer.pause();
                audioPlayer.src = 'https://stream.zeno.fm/7b1nlsk8gycuv';
                isPlaying = false;
                updatePlayerStatus('Detenido');
                updatePlayPauseButton(false);
                removeAllHighlights();
                hideAllPlayingIndicators();
                resetAllCardButtons();
                
                setTimeout(() => {
                    if (!isPlaying) {
                        document.getElementById('radio-player').style.display = 'none';
                    }
                }, 3000);
            }
        }
        
        function resetPlayer() {
            stopRadio();
            document.getElementById('radio-player').style.display = 'none';
        }
        
        // ========== FUNCIONES DE UI - BOTONES DE TARJETA ==========
        function updateCardButton(stationId, playing) {
            const card = document.getElementById(stationId);
            if (card) {
                const btn = card.querySelector('.play-pause-btn');
                if (playing) {
                    btn.classList.add('playing');
                    btn.classList.add('wave');
                } else {
                    btn.classList.remove('playing');
                    btn.classList.remove('wave');
                }
            }
        }
        
        function resetAllCardButtons() {
            document.querySelectorAll('.play-pause-btn').forEach(btn => {
                btn.classList.remove('playing');
                btn.classList.remove('wave');
            });
        }
        
        function highlightActiveCard(stationId) {
            removeAllHighlights();
            
            const activeCard = document.getElementById(stationId);
            if (activeCard) {
                activeCard.classList.add('active');
            }
        }
        
        function removeAllHighlights() {
            document.querySelectorAll('.music-card').forEach(card => {
                card.classList.remove('active');
            });
        }
        
        function showPlayingIndicator(stationId, show) {
            hideAllPlayingIndicators();
            
            const card = document.getElementById(stationId);
            if (card) {
                const indicator = card.querySelector('.playing-indicator');
                indicator.style.opacity = show ? '1' : '0';
            }
        }
        
        function hideAllPlayingIndicators() {
            document.querySelectorAll('.playing-indicator').forEach(indicator => {
                indicator.style.opacity = '0';
            });
        }
        
        // ========== FUNCIONES DE UI - REPRODUCTOR ==========
        function updatePlayerStatus(status) {
            document.getElementById('player-status').textContent = status;
        }
        
        function updatePlayPauseButton(playing) {
            const btn = document.getElementById('play-pause-btn');
            const icon = btn.querySelector('i');
            
            if (playing) {
                icon.className = 'fas fa-pause';
                btn.title = 'Pausar';
            } else {
                icon.className = 'fas fa-play';
                btn.title = 'Reproducir';
            }
        }
        
        // ========== EVENT LISTENERS ==========
        function setupEventListeners() {
            // Botones play/pause de las tarjetas
            document.querySelectorAll('.play-pause-btn').forEach(btn => {
                btn.addEventListener('click', function(e) {
                    e.stopPropagation();
                    const stationId = this.getAttribute('data-station');
                    playStation(stationId);
                });
            });
            
            // Click en las tarjetas
            document.querySelectorAll('.music-card').forEach(card => {
                card.addEventListener('click', function(e) {
                    // Evitar que se active al hacer clic en el botón
                    if (!e.target.closest('.play-pause-btn')) {
                        const stationId = this.id;
                        playStation(stationId);
                    }
                });
            });
            
            // Controles del reproductor
            document.getElementById('play-pause-btn').addEventListener('click', function() {
                if (!currentStation) return;
                
                if (isPlaying) {
                    pauseRadio();
                } else {
                    if (audioPlayer.src) {
                        audioPlayer.play()
                            .then(() => {
                                isPlaying = true;
                                updatePlayerStatus('Reproduciendo...');
                                updatePlayPauseButton(true);
                                updateCardButton(currentStation, true);
                                showPlayingIndicator(currentStation, true);
                            });
                    } else {
                        playStation(currentStation);
                    }
                }
            });
            
            document.getElementById('stop-btn').addEventListener('click', stopRadio);
            
            // Control de volumen
            document.getElementById('volume-slider').addEventListener('input', function(e) {
                volume = parseFloat(e.target.value);
                if (audioPlayer) {
                    audioPlayer.volume = volume;
                }
            });
            
            window.addEventListener('beforeunload', function() {
                if (audioPlayer) {
                    audioPlayer.pause();
                }
            });
        }
        
        
        window.addEventListener('resize', function() {
            container.innerHTML = '';

        });
    </script>

    <style>
