---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../../consts";
import Card from "../../layouts/CardsPodcast.astro";

export function getStaticPaths() {
    const arrpodcast = [
        {
            nodo: 281,
            title: "Autos al Cien",
            link: "autos-al-cien",
            imagen: "https://images.unsplash.com/photo-1494905998402-395d579af36f?auto=format&fit=crop&w=400",
            descripcion:
                "Descubre la innovación e información de la industria automotriz.",
        },
        {
            nodo: 279,
            title: "El Especial",
            link: "el-especial",
            imagen: "https://images.unsplash.com/photo-1478737270239-2f02b77fc618?auto=format&fit=crop&w=400",
            descripcion:
                "Nada se compara a la emoción de asistir a un concierto y encontrarte con tu artista favorito.",
        },
        {
            nodo: 280,
            title: "Mascotas con Estrella",
            link: "mascotas-con-estrella",
            imagen: "https://images.unsplash.com/photo-1450778869180-41d0601e046e?auto=format&fit=crop&w=400",
            descripcion:
                "Todo eso que siempre quisiste saber de tus mascotas y jamás te atreviste a preguntar.",
        },
        {
            nodo: 827,
            title: "Magazin",
            link: "magazin",
            imagen: "https://stereociendigital.com.mx/wp-content/uploads/2025/06/MAGAZIN_.PODCST.jpg",
            descripcion:
                "Recorridos llenos de nostalgia, descubrimientos y mucha música con alma.",
        },
    ];
    return arrpodcast.map((podcast) => {
        return {
            params: { link: podcast.link, imagen: podcast.imagen },
            props: { podcast, cat: podcast.nodo },
        };
    });
}

interface Props {
    podcast: any;
    cat: string;
}
//const { nodo, podcast } = Astro.params;
const { link } = Astro.params;
const { podcast } = Astro.props;
const { cat } = Astro.props;

const res = await fetch(
    "https://stereociendigital.com.mx/wp-json/wp/v2/posts?_embed&fields=title,acf&per_page=10&categories=" +
        cat,
);
const posts = await res.json();
---

<BaseLayout title="Podcast" description={SITE_DESCRIPTION}>
    <Header title={SITE_TITLE} />

    <main>
        <div class="container my-12 mx-auto px-4 md:px-12">
            <div class="flex flex-wrap justify-center">
                <div class="w-full md:w-1/3 lg:w-1/4">
                    <img
                        class="content-center shadow-xl"
                        src={podcast.imagen}
                    />
                </div>
                <div class="w-full md:w-2/3 lg:w:3/4 p-4 flex items-center">
                    <div>
                        <h1
                            class="audiowide neon-morado text-center md:text-left font-bold text-3xl md:text-4xl lg:text-3xl xl:text-4xl align-middle"
                        >
                            {podcast.title}
                        </h1>
                        <p class="align-middle">{podcast.descripcion}</p>
                    </div>
                </div>
            </div>
            <section class="flex flex-wrap -mx-4">
                {
                    posts.map((post: any) => (
                        <>
                            <Card {post} />
                        </>
                    ))
                }
            </section>
            <div class="m-auto text-center">
                <a
                    href={`/podcast/${link}/2`}
                    class="text-white hover:text-black"
                >
                    <button
                        class="ver-mas group relative h-8 w-36 m-4 overflow-hidden rounded-xl bg-[rgba(52,52,52,0.2)] hover:bg-white border-2 border-white uppercase text-xs poppins font-bold tracking-[3px]"
                    >
                        <span>Siguiente</span>
                    </button>
                </a>
            </div>

            <div class="text-center">
                <a href={`/podcast/${link}/2`}>
                    <button
                        class="ver-mas group relative h-8 w-36 m-4 overflow-hidden rounded-lg bg-zinc-700 text-base shadow"
                    >
                        <div
                            class="absolute inset-0 w-3 bg-[var(--amarillo-beat)] transition-all duration-[250ms] ease-out group-hover:w-full"
                        >
                        </div>
                        <span
                            class="relative text-zinc-200 group-hover:text-zinc-900"
                            >Siguiente</span
                        >
                    </button>
                </a>
            </div>
        </div>
    </main>
    <Footer />
</BaseLayout>
