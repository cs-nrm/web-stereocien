---
import BaseHead from '../../../components/BaseHead.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../../../consts.js';
/*import {getArticles} from '../../../lib/api.js';*/
import Card from '../../../layouts/CardsPodcast.astro';
import BarNrm from '../../../components/BarNrm.astro';


export async function getStaticPaths( { paginate } ) {
    
    const arrpodcast = [
        {nodo: 281,title: 'Autos al Cien', link: 'autos-al-cien', imagen: 'https:/contenido.stereociendigital.mx/wp-content/uploads/2024/06/GROOVE-DEALERS-PODCAST-min.png', descripcion: 'En este programa, las ondas de radio se miden en kilómetros por hora. La Innovación e información de la industria automotriz, encuéntrala en Autos al Cien con Memo Lira, el periodista que más sabe de autos.'},
        {nodo: 279,title: 'El Especial', link: 'el-especial', imagen: 'https://contenido.stereociendigital.mx/wp-content/uploads/2023/12/poscast-repira2.jpg', descripcion: 'Nada se compara a la emoción de asistir a un concierto, y encontrarte con tu artista favorito, rodeado de otras personas que comparten el mismo entusiasmo. Revive esa experiencia a través de El Especial. Una hora con lo mejor de la música en vivo. Cada semana, descubre a tus artistas favoritos en concierto.'},
        {nodo: 280,title: 'Mascotas', link: 'mascotas-con-estrella', imagen: 'https://contenido.stereociendigital.mx/wp-content/uploads/2023/10/EX_secretos5.jpg', descripcion: 'Temas de interés sobre nuestras mascotas.'},
    ]; 

  
  const res = await fetch("https://contenido.stereociendigital.mx/wp-json/wp/v2/posts?_embed&per_page=250&_fields=title,slug,yoast_head_json,categories,acf&categories=281,279,280" ); 
  const posts = await res.json();
  //console.log(posts);
  
  return arrpodcast.flatMap( function(pod) {      
      const podcast = pod.link; 
      //console.log(pod.nodo);           
      const filteredPosts = posts.filter((post:any) => post.categories[0]  == pod.nodo || post.categories[1]  == pod.nodo );                      
      //console.log(filteredPosts);
      return paginate(filteredPosts,{
        params:{ podcast },
        props: { pod},
        pageSize: 10
      });
  });  
}

interface Props{
  page: any; 
  podcast: any;
  pod:any; 
}

const { page = [] } = Astro.props;
const { podcast, pod } = Astro.props;
/*const { pod } = Astro.props;*/

---
<!doctype html>
<html lang="es">
  <head>
    <BaseHead title={SITE_TITLE} seccion="Podcast" description={SITE_DESCRIPTION} />
    
  </head>
  <body>
    <BarNrm />
    <Header title={SITE_TITLE} />
    
    <main>
            
      <div class="container my-12 mx-auto px-4 md:px-12">
        <div class="flex flex-wrap justify-center ">
          <div class="w-full md:w-1/3 lg:w-1/4"><img class="content-center aspect-square shadow-xl rounded" src={pod.imagen}/></div>
          <div class="w-full md:w-2/3 lg:w:3/4 p-4 flex items-center">
            <div>
              <h1 class="audiowide neon-morado text-center md:text-left font-bold text-3xl md:text-4xl lg:text-3xl xl:text-4xl align-middle">{pod.title} </h1>
              <p class="align-middle">{pod.descripcion}</p>
            </div> 
          </div>
        </div>
        <section class="flex flex-wrap -mx-4">
          { 
            page.data.map((post:any) => ( 
            <>
              <Card post={post} />
            </>
            ))
          }
        </section>
            <div class="m-auto text-center">
                {page.url.prev && <a href={page.url.prev} class="text-black hover:text-white">
                    <button class="ver-mas lovelo group relative h-8 w-36 m-4 overflow-hidden bg-white hover:bg-black uppercase text-xs font-bold tracking-[3px]">
                        <span>Anterior</span>
                    </button>
                </a>}
                {page.url.next && <a href={page.url.next} class="text-black hover:text-white">
                    <button class="ver-mas lovelo group relative h-8 w-36 m-4 overflow-hidden bg-white hover:bg-black uppercase text-xs font-bold tracking-[3px]">
                        <span>Siguiente</span>
                    </button>
                </a>}
            </div>
      </div>  
    </main>
    <Footer />
  </body>
</html>