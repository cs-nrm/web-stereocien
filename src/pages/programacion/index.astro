<style>
@media (max-width: 720px) {
    .tabs.programacion nav, .tabs.programacion-enfoque nav{
        overflow-x: scroll;
        justify-content: normal !important;
    }
}

[role="tabpanel"] {
  opacity: 1;
  transform: translateY(0);
  transition: opacity 0.4s ease, transform 0.4s cubic-bezier(.4,2,.6,1);
}

[role="tabpanel"].hidden,
[role="tabpanel"].opacity-0 {
  opacity: 0;
  transform: translateY(20px);
  transition: opacity 0.4s ease, transform 0.4s cubic-bezier(.4,2,.6,1);
}

#estacion [role="tab"] {
  position: relative;
  transition: color 0.3s, transform 0.3s;
  overflow: hidden;
}

#estacion [role="tab"]::after {
  content: '';
  position: absolute;
  left: 50%;
  bottom: 0.3em;
  width: 0;
  height: 3px;
  background: #ef4444;
  border-radius: 2px;
  transition: width 0.3s cubic-bezier(.4,2,.6,1), left 0.3s cubic-bezier(.4,2,.6,1);
}

#estacion [role="tab"][aria-selected="true"] {
  color: #ef4444 !important;
  /*transform: scale(1.08);*/
  background-color: rgb(255, 255, 255);
  border-radius: 0.375rem;
}

#estacion [role="tab"][aria-selected="true"]::after {
  width: 80%;
  left: 10%;
}
</style>