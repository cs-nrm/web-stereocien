---
/**
 * 404.
 *
 * Una página que se sirve MUCHO: en `web-enfoque` los 404 son el 28 % del tráfico
 * —bots y enlaces viejos—, y aquí va a pesar más en el corte, porque el sitio
 * viejo tiene unas mil notas vivas en `/<sección>/<slug>/`. Las que se migren
 * llegan a su nota nueva por el mapa de 301 que consulta el middleware
 * (`src/config/redirecciones/sitio-viejo.json`, que llena el importador); las que
 * no, y los índices de sección, caen aquí. Por eso es barata: no consulta el CMS
 * más de lo que ya consulta el layout (heredado de web-beat).
 *
 * También es a donde reescribe una nota que no existe
 * (`src/pages/noticias/[slug].astro`), y con estado 404 real.
 */
import Base from '@/layouts/Base.astro';
---

<Base
  titulo="No encontramos esa página — Stereo Cien 100.1"
  descripcion="La página que buscas no existe o cambió de lugar."
>
  <div class="e404">
    <p class="e404-codigo">Error 404</p>
    <h1 class="e404-titulo">Esta página no existe</h1>
    <p class="e404-texto">
      Puede que el enlace esté roto, o que la página haya cambiado de lugar con el sitio nuevo.
    </p>
    <a href="/" class="e404-salida">
      Ir al inicio
      <svg
        aria-hidden="true"
        focusable="false"
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.4"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M5 12h14M13 6l6 6-6 6"></path>
      </svg>
    </a>
  </div>
</Base>

<style>
  .e404 {
    box-sizing: content-box;
    max-width: 640px;
    margin: 0 auto;
    padding: 88px var(--margen-revista) 120px;
  }
  .e404-codigo {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 900;
    font-size: var(--text-etiqueta);
    line-height: var(--text-etiqueta--line-height);
    letter-spacing: var(--tracking-etiqueta);
    text-transform: uppercase;
    color: var(--color-azul-principal);
  }
  .e404-titulo {
    margin: 16px 0 0;
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(44px, 4vw, 72px);
    line-height: 0.92;
    letter-spacing: var(--tracking-titular);
    text-transform: uppercase;
    text-wrap: balance;
  }
  .e404-texto {
    margin: 22px 0 0;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 20px;
    line-height: 30px;
    text-wrap: pretty;
  }
  /* El botón de marca del diseño: azul, 48 px, en mayúsculas con 3 px. */
  .e404-salida {
    margin-top: 34px;
    height: 48px;
    box-sizing: border-box;
    padding: 0 22px;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: var(--color-azul-principal);
    color: var(--color-blanco);
    font-family: var(--font-display);
    font-weight: 900;
    font-size: var(--text-etiqueta);
    letter-spacing: var(--tracking-etiqueta);
    text-transform: uppercase;
  }
  .e404-salida:hover {
    background: var(--color-marino);
    color: var(--color-blanco);
  }

  @media (max-width: 1279px) {
    .e404 {
      padding: 48px var(--margen-revista) 72px;
    }
    .e404-titulo {
      font-size: 38px;
    }
    .e404-texto {
      font-size: 17px;
      line-height: 26px;
    }
  }
</style>
