---
/**
 * El cascarón del sitio: «la radio fija, la revista con scroll» (§1 del handoff).
 *
 * Dos mitades dentro de `.split`:
 *   · el `<aside class="barra">`, con la radio, que lleva `transition:persist` y
 *     NO se recarga al navegar. Es el corazón del concepto (§14 del handoff): el
 *     reproductor que venga no se puede cortar al cambiar de página;
 *   · el `<main>`, con la cabecera, lo que pone cada página y el pie.
 * Dónde está y cuánto mide cada una vive en `src/styles/sitio.css`; lo de dentro
 * de la barra, en `src/components/Barra.astro`.
 *
 * El `<head>` se porta de web-beat casi entero, porque ahí está lo que ya se
 * pagó: la canónica, las reglas de indexación, Open Graph con sus medidas, el
 * JSON-LD y la medición con sus guardas. Lo que cambia es de la estación.
 */
import '@/styles/base.css';
import {
  IDIOMA_REGION,
  LOCALE_OG,
  NOINDEX_SITIO,
  SITE_URL,
  TARJETA_COMPARTIR,
  noIndexarHost,
} from '@/config/site';
import { nodoEstacion, serializar } from '@/lib/jsonld';
import { obtenerEstacion, redesEstacion, type Estacion } from '@/lib/cms/estacion';
import { ClientRouter } from 'astro:transitions';
import Barra from '@/components/Barra.astro';
import Cabecera from '@/components/Cabecera.astro';
import Pie from '@/components/Pie.astro';

interface Props {
  /** El `<title>` completo. Las páginas interiores lo cierran con «— Stereo Cien 100.1». */
  titulo: string;
  descripcion?: string;
  /**
   * La imagen con la que se ve esta página al compartirla. Una nota pasa la suya;
   * el resto no pasa nada y cae a la tarjeta de marca.
   *
   * Puede ser absoluta —lo que devuelve `urlMedia`, que ya trae el host del CMS— o
   * una ruta de `public/`, que se vuelve absoluta aquí.
   */
  imagen?: string | null;
  /**
   * Qué se ve en esa imagen, para quien no la ve. En una nota es el `alt` de su
   * foto, tal como lo capturó la redacción.
   *
   * Si no viene, la etiqueta NO se emite (heredado de web-beat): un `alt`
   * inventado desde el layout describiría una foto que este archivo no ha visto.
   */
  imagenAlt?: string | null;
  /**
   * Las medidas REALES de esa imagen, cuando se conocen (`medidaMedia`). Las
   * plataformas reservan el hueco de la tarjeta con estos números antes de bajar
   * el archivo, así que unas medidas falsas se ven como un recorte raro.
   */
  imagenAncho?: number | null;
  imagenAlto?: number | null;
  /** `article` en una nota; `website` en todo lo demás. */
  tipo?: 'website' | 'article';
  /** La fecha de publicación en ISO. Solo con `tipo="article"`. */
  publicado?: string | null;
  /**
   * La última modificación en ISO. Solo con `tipo="article"`, y en pareja con
   * `publicado`: sin ella una nota corregida parece la de su día de estreno.
   */
  modificado?: string | null;
  /**
   * Este DOCUMENTO no se indexa, lo diga el host lo que diga: `noticias.meta.noIndex`
   * del CMS, que la redacción marca en una nota concreta.
   *
   * Solo SUMA restricción, nunca la quita: se combina con un `||`, así que un
   * `false` del CMS no puede abrirle a Google un staging (heredado de web-beat).
   * La cabecera `X-Robots-Tag` de ese documento la pone la propia página; ver
   * `src/pages/noticias/[slug].astro`.
   */
  noIndex?: boolean;
}

const {
  titulo,
  descripcion,
  imagen = null,
  imagenAlt = null,
  imagenAncho = null,
  imagenAlto = null,
  tipo = 'website',
  publicado = null,
  modificado = null,
  noIndex = false,
} = Astro.props;

/** El Inicio se distingue por la RUTA, no por lo que declare la página. */
const esInicio = Astro.url.pathname === '/';

/**
 * El nombre del sitio, para `og:site_name`.
 *
 * Es el MISMO texto que el `NOMBRE` de `src/lib/jsonld.ts` y que el sufijo de cada
 * `<title>` interior, y los tres tienen que decir lo mismo. Coincide con
 * `estaciones.nombre` del CMS; va escrito y no leído del CMS para que un fallo del
 * CMS no deje las tarjetas de compartir sin nombre.
 */
const NOMBRE_SITIO = 'Stereo Cien 100.1';

/**
 * El chrome se resuelve UNA vez aquí y baja por props: la estación (para el mount
 * de la barra y el nombre del pie) y sus redes (para el pie y el JSON-LD del
 * Inicio, que tienen que enlazar a las mismas cuentas). Las dos van en paralelo y
 * las dos están memorizadas o cacheadas en el cliente del CMS, así que no cuestan
 * por página.
 *
 * Si el CMS no responde, el sitio se sirve igual (heredado de web-beat: degradar
 * es la regla). La estación cae a lo mínimo que la barra y el pie necesitan, con
 * los valores verificados de Stereo Cien. El mount `XEOYAM` es el de Stereo Cien
 * Digital, el flujo solo de música que reproduce el sitio; que diga AM en una FM
 * es correcto (ver `estaciones.notaStream` en el CMS).
 */
const [estacion, redes] = await Promise.all([
  obtenerEstacion().catch(() => null),
  redesEstacion().catch(() => []),
]);

const marca: Pick<Estacion, 'nombre' | 'nombrePublicacion' | 'tritonMount'> = estacion ?? {
  nombre: 'Stereo Cien 100.1',
  nombrePublicacion: 'STEREO CIEN',
  tritonMount: 'XEOYAM',
};

/*
  Las reglas de indexación. Heredado de web-beat, igual que en el middleware, MÁS
  la del documento.

  Las dos primeras hablan del DESPLIEGUE —el dominio con el que se compiló y el
  `Host` de esta petición— y las pone también el middleware por cabecera, que
  protege toda respuesta; este `<meta>` es su segunda capa.

  La tercera es `noIndex`, y es de otra naturaleza: la trae el documento del CMS.
  Se combinan con `||` a propósito: cada una solo puede CERRAR.
*/
const despliegueNoIndexable = NOINDEX_SITIO || noIndexarHost(Astro.url.hostname);
const noIndexar = despliegueNoIndexable || noIndex;

/*
  La canónica: la ruta SIN barra final (salvo la raíz) y SIN query. Es el contrato
  de URL del sitio: el middleware responde 301 de `/x/` a `/x`, y esta etiqueta
  dice lo mismo por si una copia con barra llega a servirse.

  El query se descarta entero: un `?utm_source=…` o un `?fbclid=…` no hacen otra
  página, y dejarlos entrar convertiría cada enlace compartido en una URL canónica
  distinta (heredado de web-beat).
*/
const rutaCanonica = Astro.url.pathname.replace(/\/+$/, '') || '/';
const canonical = new URL(rutaCanonica, SITE_URL).href;

/**
 * La imagen de compartir, SIEMPRE absoluta y siempre presente.
 *
 * Facebook y X descartan una `og:image` relativa sin decir nada: la publicación
 * sale sin imagen y desde el sitio no se nota. Se resuelve contra `SITE_URL` —el
 * dominio CANÓNICO— y no contra el host que sirve, igual que la canónica: lo que
 * se publica apunta al sitio real, no a un staging (ver la trampa anotada en
 * `TARJETA_COMPARTIR`).
 */
const imagenCompartir = new URL(imagen ?? TARJETA_COMPARTIR.ruta, SITE_URL).href;

/**
 * Lo que se sabe de esa imagen, elegido JUNTO y del mismo lado: si la página trae
 * foto propia, las medidas son las suyas o no hay; jamás las de la tarjeta de
 * marca.
 *
 * El `alt` del respaldo describe lo que `scripts/tarjetas.mjs` genera: el logo en
 * blanco centrado sobre el azul de la marca. Si la tarjeta se dibuja de otra
 * forma, este texto se cambia con ella.
 */
const tarjeta = imagen
  ? { alt: imagenAlt, ancho: imagenAncho, alto: imagenAlto }
  : {
      alt: 'El logo de Stereo Cien en blanco sobre el azul de la marca.',
      ancho: TARJETA_COMPARTIR.ancho,
      alto: TARJETA_COMPARTIR.alto,
    };

/**
 * La descripción de respaldo: una página sin bajada no debe compartirse muda.
 *
 * Es la frase con la que el sitio viejo se presentaba (`SITE_DESCRIPTION` de
 * `src/consts.ts` en la rama `stereocien`), recortada a lo que la estación ES. Lo
 * que no dice, a propósito: que aquí se escucha la radio. Hoy el sitio no tiene
 * reproductor, y la descripción es lo que se lee en WhatsApp al compartir el enlace.
 */
const RESUMEN_CASA =
  'Descubre lo mejor de la música, tendencias, vida, estilo y cultura pop en Stereo Cien 100.1 FM.';

/**
 * La descripción se recorta a 160 caracteres, y el recorte vive AQUÍ (heredado de
 * web-beat). Google corta ahí, y la mitad de las rutas pasan un campo del CMS
 * —el `resumen` de una nota— que la redacción escribe sin un contador delante.
 *
 * Se corta en el ESPACIO anterior y se cierra con «…», no a mitad de palabra; y
 * se colapsan los espacios, porque un campo largo del CMS trae saltos de línea.
 */
const TOPE_RESUMEN = 160;

function recortar(texto: string): string {
  const limpio = texto.replace(/\s+/g, ' ').trim();
  if (limpio.length <= TOPE_RESUMEN) return limpio;
  const corte = limpio.slice(0, TOPE_RESUMEN - 1);
  const espacio = corte.lastIndexOf(' ');
  const base = espacio > TOPE_RESUMEN / 2 ? corte.slice(0, espacio) : corte;
  return `${base.replace(/[\s.,;:—–-]+$/, '')}…`;
}

const resumen = recortar(descripcion?.trim() || RESUMEN_CASA);

/**
 * La ficha de la ESTACIÓN en JSON-LD, y va solo en el Inicio.
 *
 * Vive en el layout y no en la página porque los dos datos que la sostienen —el
 * nombre público y las redes— ya están resueltos aquí arriba, y son LOS MISMOS que
 * pinta el pie. Resolverlos otra vez abriría la puerta a que el `sameAs` enlace a
 * una cuenta distinta de la que el lector ve (heredado de web-beat).
 */
const fichaEstacion = esInicio
  ? serializar([
      nodoEstacion({
        nombrePublico: marca.nombrePublicacion,
        redes: redes.map((r) => r.url),
      }),
    ])
  : null;

/**
 * LOS CUATRO CONTENEDORES DE MEDICIÓN, y sus DOS guardas.
 *
 * 1. **Sin valor en el env, el snippet NO se emite** (heredado de web-beat). Son
 *    `PUBLIC_*`, y Vite las hornea AL COMPILAR: llenar el `.env` no enciende nada
 *    hasta que se RECONSTRUYE.
 *
 * 2. **Fuera del dominio canónico, tampoco**: si ESTA petición es de un
 *    despliegue que no se indexa —un staging, una preproducción, `localhost`—, no
 *    se mide. Es la guarda que web-beat no tenía y que aquí se agrega: el staging y
 *    el sitio real pueden ser el MISMO build, así que la variable sola no los
 *    distingue, y el caro es comScore, que es la medición que NRM le reporta a los
 *    anunciantes para justificar CPMs. Ensuciarlo no deja un dato feo: infla una
 *    cifra de audiencia CERTIFICADA con tráfico que no es audiencia.
 *
 *    Se mira el DESPLIEGUE, no el documento: una nota que la redacción marcó
 *    `noIndex` sí es audiencia real y se mide.
 *
 *    Consecuencia que hay que saber: esta guarda depende de lo mismo que el
 *    `noindex` —`security.allowedDomains` en `astro.config.mjs`, sin el cual el
 *    `Host` de producción llega como `localhost`—. Si esa lista falla, el sitio real
 *    sale sin indexar Y sin medir, las dos cosas a la vez. Al menos se nota.
 *
 * `PUBLIC_GA_ID` no está en esta lista a propósito: **GA4 entra por GTM y nunca
 * directo**, así que aquí no se baja `gtag/js` en ningún caso. Con las dos vías
 * las páginas vistas salen al DOBLE, y el síntoma se parece tanto a un buen mes
 * que puede tardar semanas en levantar sospechas (heredado de web-beat).
 *
 * El `.trim()` hace que un `PUBLIC_HOTJAR_ID=" "` mal pegado cuente como ausente
 * en vez de cargar un contenedor con un id en blanco.
 */
const medir = !despliegueNoIndexable;
const contenedor = (valor?: string): string | null => (medir && valor?.trim()) || null;

const GTM_ID = contenedor(import.meta.env.PUBLIC_GTM_ID);
const COMSCORE_C2 = contenedor(import.meta.env.PUBLIC_COMSCORE_C2);
const HOTJAR_ID = contenedor(import.meta.env.PUBLIC_HOTJAR_ID);
const METRICOOL_HASH = contenedor(import.meta.env.PUBLIC_METRICOOL_HASH);
---

<!doctype html>
{/*
  `color-scheme: light`: el sitio es claro (§8: fondo gris, cabecera y tarjetas
  blancas) y la barra azul es su única superficie oscura. Así el navegador pinta
  sus propios controles y el fondo antes del CSS en claro, aunque el sistema del
  lector esté en oscuro.
*/}
<html lang={IDIOMA_REGION} style="color-scheme: light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <meta name="description" content={resumen} />
    <link rel="canonical" href={canonical} />

    {/*
      Open Graph y Twitter Card (heredado de web-beat).

      `og:image` va ABSOLUTA o no cuenta, y el fallo es silencioso. Las tres
      etiquetas de la imagen —alt, ancho, alto— se emiten solo si el dato existe:
      ver `tarjeta` arriba.

      `twitter:card` es lo único que X necesita de su propio espacio de nombres; el
      resto lo lee de Open Graph. `twitter:site` es la cuenta de la estación, la
      misma que declaraba el sitio viejo (`@stereocienmx`).
    */}
    <meta property="og:site_name" content={NOMBRE_SITIO} />
    <meta property="og:locale" content={LOCALE_OG} />
    <meta property="og:type" content={tipo} />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={resumen} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imagenCompartir} />
    {tarjeta.alt && <meta property="og:image:alt" content={tarjeta.alt} />}
    {
      tarjeta.ancho && tarjeta.alto && (
        <>
          <meta property="og:image:width" content={String(tarjeta.ancho)} />
          <meta property="og:image:height" content={String(tarjeta.alto)} />
        </>
      )
    }
    {tipo === 'article' && publicado && <meta property="article:published_time" content={publicado} />}
    {tipo === 'article' && modificado && <meta property="article:modified_time" content={modificado} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@stereocienmx" />

    {/*
      Los iconos los genera `scripts/tarjetas.mjs` (el delfín sobre la ola, el
      mismo icono del sitio viejo) y viven en `/favicon/`, la carpeta de siempre.
      `sizes="any"` en el `.ico` le dice al navegador que sirve para cualquier
      medida, así que la declaración de 32 gana para la suya.
    */}
    <link rel="icon" href="/favicon/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon/favicon-32x32.png" />
    <link rel="apple-touch-icon" href="/favicon/apple-touch-icon.png" />
    {/*
      El color con el que el navegador pinta SU cromo (la barra de direcciones en
      Android): el blanco de la cabecera, que es lo que toca el borde de arriba en
      el móvil. Mismo criterio que web-beat: que no quede una franja de otro color
      encima de la página.
    */}
    <meta name="theme-color" content="#ffffff" />
    <meta name="robots" content={noIndexar ? 'noindex, nofollow' : 'index, follow'} />

    {/*
      Las dos fuentes que pinta la primera pantalla: la display (la barra, los
      rótulos, los titulares) y la de interfaz. Libre Baskerville no va: solo
      aparece con notas, más abajo o en otra página. Solo el subconjunto `latin`,
      que es el que el español usa.

      Los nombres los pone `scripts/fuentes.mjs` (familia, peso, subconjunto): si
      se vuelven a generar con otros pesos, estas dos rutas se revisan.
      `crossorigin` es obligatorio en una fuente precargada aunque sea del mismo
      origen: sin él el navegador la baja dos veces.
    */}
    <link
      rel="preload"
      href="/fuentes/montserrat-900-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="preload" href="/fuentes/roboto-400-700-latin.woff2" as="font" type="font/woff2" crossorigin />

    {/*
      Los datos estructurados de la ESTACIÓN. Solo en el Inicio; ver
      `fichaEstacion` arriba.

      guarda-ok set:html: es el único modo de emitir JSON-LD en Astro, y el valor
      no es HTML del CMS sino JSON que arma `serializar()`, que además escapa `<`.
      Ver `src/lib/jsonld.ts`.

      `is:inline` es obligatorio: sin él Astro trata el bloque como un script del
      sitio y se lo lleva al bundle, donde ningún rastreador lo va a leer.
    */}
    {fichaEstacion && <script type="application/ld+json" is:inline set:html={fichaEstacion} />}

    {/*
      SIN ESTO el `transition:persist` de la barra NO HACE NADA: cada navegación
      sería una carga completa del documento y el reproductor se cortaría al
      cambiar de página. En web-beat estuvo faltando desde que se construyó la
      cabecera: el atributo estaba puesto y no servía de nada.
    */}
    <ClientRouter />

    {/*
      LA MEDICIÓN. Los cuatro contenedores, cada uno tras su guarda; la regla y el
      porqué están arriba, con las constantes.

      Ninguno bloquea el render: lo que pesa —la librería de cada contenedor— se
      inyecta con `async`. Y ninguno se vuelve a ejecutar al navegar: el
      `ClientRouter` recuerda por su TEXTO cada script en línea que ya corrió y no
      lo repite al reemplazar el `head`. Por eso aquí NUNCA va `data-astro-rerun`:
      bajaría un contenedor nuevo por navegación y contaría todo dos veces
      (heredado de web-beat, comprobado allá con un solo `gtm.start` en la cola tras
      ir y volver).
    */}
    {
      GTM_ID && (
        <>
          {/*
            La cola ANTES del contenedor: un evento que llegue antes de que baje
            `gtm.js` no se pierde. Va DENTRO de la guarda de GTM: `dataLayer` sin
            contenedor que la vacíe sería un array que nadie lee, y
            `Array.isArray(window.dataLayer)` es lo que dice si hay receptor.
          */}
          <script is:inline>window.dataLayer = window.dataLayer || [];</script>
          {/*
            El contenedor central. GA4 y lo demás se activan DENTRO de GTM, no aquí.
            Del snippet canónico de Google se cae el parámetro `l`, que renombra la
            cola: aquí se llama `dataLayer` siempre.
          */}
          <script is:inline define:vars={{ idGtm: GTM_ID }}>
            window.dataLayer.push({ 'gtm.start': Date.now(), event: 'gtm.js' });
            (function (d) {
              var primero = d.getElementsByTagName('script')[0];
              var etiqueta = d.createElement('script');
              etiqueta.async = true;
              etiqueta.src = 'https://www.googletagmanager.com/gtm.js?id=' + idGtm;
              primero.parentNode.insertBefore(etiqueta, primero);
            })(document);
          </script>
        </>
      )
    }
    {/*
      comScore. Lo que NRM le reporta a los anunciantes: cualquier cambio se
      coordina con adops y no se prueba en producción.

      `c1: '2'` es la constante de comScore para «página web»; lo único de la
      cuenta es `c2`. Las dos `options` vienen tal cual del sitio viejo
      (`src/components/head/AnalyticsScripts.astro` en la rama `stereocien`), que
      es como adops lo tiene configurado hoy: cookie de primera parte y sin esperar
      consentimiento. En el sitio no hay CMP; si algún día entra uno,
      `bypassUserConsentRequirement…` es la primera línea que hay que revisar,
      porque es exactamente la que se lo salta.
    */}
    {
      COMSCORE_C2 && (
        <script is:inline define:vars={{ c2Comscore: COMSCORE_C2 }}>
          window._comscore = window._comscore || [];
          window._comscore.push({
            c1: '2',
            c2: c2Comscore,
            options: {
              enableFirstPartyCookie: true,
              bypassUserConsentRequirementFor1PCookie: true,
            },
          });
          (function (d) {
            var primero = d.getElementsByTagName('script')[0];
            var etiqueta = d.createElement('script');
            etiqueta.async = true;
            etiqueta.src = 'https://sb.scorecardresearch.com/cs/' + c2Comscore + '/beacon.js';
            primero.parentNode.insertBefore(etiqueta, primero);
          })(document);
        </script>
      )
    }
    {/*
      Hotjar. `hj` se define como cola antes de que baje la librería, para que una
      llamada temprana no se pierda. `hjsv` es la versión del SNIPPET que publica
      Hotjar, no una nuestra; y el `Number()` está porque del env el id llega
      siempre como cadena.
    */}
    {
      HOTJAR_ID && (
        <script is:inline define:vars={{ idHotjar: HOTJAR_ID }}>
          window.hj =
            window.hj ||
            function () {
              (window.hj.q = window.hj.q || []).push(arguments);
            };
          window._hjSettings = { hjid: Number(idHotjar), hjsv: 6 };
          (function (d) {
            var etiqueta = d.createElement('script');
            etiqueta.async = true;
            etiqueta.src =
              'https://static.hotjar.com/c/hotjar-' +
              window._hjSettings.hjid +
              '.js?sv=' +
              window._hjSettings.hjsv;
            d.head.appendChild(etiqueta);
          })(document);
        </script>
      )
    }
    {/*
      Metricool. Se escribe igual que los otros para que encenderlo sea llenar una
      variable y reconstruir. Llama a `beTracker` solo si existe: un `be.js` que no
      baja no deja un TypeError en la consola de cada página.
    */}
    {
      METRICOOL_HASH && (
        <script is:inline define:vars={{ hashMetricool: METRICOOL_HASH }}>
          (function (d) {
            var etiqueta = d.createElement('script');
            etiqueta.async = true;
            etiqueta.src = 'https://tracker.metricool.com/resources/be.js';
            etiqueta.onload = function () {
              if (window.beTracker) window.beTracker.t({ hash: hashMetricool });
            };
            d.head.appendChild(etiqueta);
          })(document);
        </script>
      )
    }
  </head>
  <body>
    <a class="saltar" href="#contenido">Saltar al contenido</a>

    {/*
      Los dos `<noscript>` de la medición: el iframe de GTM y el pixel de comScore,
      cada uno tras la misma guarda que su script.

      Van en el `<body>` y no en el `<head>`: el `<head>` solo admite metadatos, y un
      `<img>` o un `<iframe>` ahí le dice al parser que el head terminó (heredado de
      web-beat).

      El pixel del sitio viejo va ROTO y el error no se hereda: lleva `cv=cv=4.4.0`
      y un salto de línea que parte `cj=1` a mitad de la URL.
    */}
    {
      GTM_ID && (
        <noscript>
          <iframe
            src={`https://www.googletagmanager.com/ns.html?id=${GTM_ID}`}
            title="Google Tag Manager"
            height="0"
            width="0"
            style="display:none;visibility:hidden"
          />
        </noscript>
      )
    }
    {
      COMSCORE_C2 && (
        <noscript>
          <img
            src={`https://sb.scorecardresearch.com/p?c1=2&c2=${COMSCORE_C2}&cv=4.4.0&cj=1`}
            alt=""
            height="1"
            width="1"
            style="display:none"
          />
        </noscript>
      )
    }

    <div class="split">
      {/*
        LA BARRA, y el nombre de `transition:persist` va EXPLÍCITO. Heredado de
        web-beat, donde se midió: sin nombre, Astro genera uno por POSICIÓN y no
        coincide entre páginas que tengan distinto número de elementos con
        directiva de transición delante; con nombres distintos no hay nada que
        emparejar y el nodo se reemplaza en silencio.

        `aria-label` porque un `<aside>` es un punto de referencia y el lector de
        pantalla lo anuncia por su nombre: «Radio en vivo», como en el tablero.
      */}
      <aside class="barra" aria-label="Radio en vivo" transition:persist="barra">
        <Barra mount={marca.tritonMount} />
      </aside>

      <main class="principal">
        <Cabecera />
        <div class="revista" id="contenido">
          <slot />
        </div>
        <Pie nombre={marca.nombre} redes={redes} />
      </main>
    </div>
  </body>
</html>
