---
import DoubleBox from '../components/DoubleBox.astro';
import BoxBanner from '../components/BoxBanner.astro';
import LeaderBoard from'../components/LeaderBoard.astro';
import SuperLeader from '../components/SuperLeader.astro';
import { Image } from 'astro:assets';


const ressti = await fetch("https://contenido.stereociendigital.mx/wp-json/wp/v2/posts?_fields=date,title,slug,sticky,yoast_head_json,excerpt,_links,_embedded&_embed&per_page=1&categories=143&sticky=true");

const poststi = await ressti.json();

---
 <div class="wine-route">
    <div class="wine-content">
      <span class="category lovelo">CON ESTILO</span>
      <h2>SE LANZA LA RUTA DEL VINO Y EL QUESO 2025</h2>
      <p>México, un país de contrastes, nos sorprende una vez más con sus rutas del vino para este 2025, experimentado un notable crecimiento en la producción de vino transmitiendo emociones mediante el sabor.</p>
      <span class="author font-bold roboto">por Alex Loam</span>
    </div>
    <div class="wine-image">
      <img src="/img/uvas.jpg" alt="Uvas para vino">
    </div>
  </div>


<style>
.wine-route {
  display: grid;
  grid-template-columns: 1fr 1fr;
  min-height: 600px;
  background: black;
  margin-top: 4rem;
}

.wine-content {
  padding: 4rem;
  display: flex;
  flex-direction: column;
  justify-content: center;
  max-width: 600px;
  margin: 0 auto;
  color: white;
  text-align: center;
}

.wine-content .category {
  font-size: 0.875rem;
  font-weight: 500;
  margin-bottom: 1.5rem;
  text-transform: uppercase;
}

.wine-content h2 {
  font-size: 2.5rem;
  font-weight: bold;
  line-height: 1.2;
  margin-bottom: 1.5rem;
  text-transform: uppercase;
}

.wine-content p {
  font-size: 1.125rem;
  line-height: 1.6;
  margin-bottom: 1.5rem;
  color: #d1d1d1;
}

.wine-content .author {
  font-size: 0.875rem;
  color: #888;
}

.wine-image {
  position: relative;
  overflow: hidden;
}

.wine-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  filter: grayscale(100%);
}

@media (max-width: 900px) {
  .wine-route{min-height: auto;}
  .wine-content {padding: 1rem;}
  .wine-content p{display: none;  }
}
@media (max-width: 640px) {
  .wine-content h2{font-size: 1.5rem;}
  .wine-content .author, .wine-content .category{ font-size: 0.6rem;}
}
</style>