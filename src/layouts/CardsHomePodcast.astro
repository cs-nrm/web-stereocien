const res_especial = await fetch("https://contenido.stereociendigital.mx/wp-json/wp/v2/posts?_fields=title,slug,categories,yoast_head_json,_links,_embedded&_embed&per_page=1&categories=279");
const post_especial = await res_especial.json();

const res_mascotas = await fetch("https://contenido.stereociendigital.mx/wp-json/wp/v2/posts?_fields=title,slug,categories,yoast_head_json,_links,_embedded&_embed&per_page=1&categories=280");
const post_mascotas = await res_mascotas.json();

const res_autos = await fetch("https://contenido.stereociendigital.mx/wp-json/wp/v2/posts?_fields=title,slug,categories,yoast_head_json,_links,_embedded&_embed&per_page=1&categories=281");
const post_autos = await res_autos.json();
---
<div class="cont-pod">
    <div class="recipe-container p-4 md:p-2 lg:px-12">
        <h1 class ="oswald text-white text-center p-6">Podcast</h1>
        <div class="flex flex-wrap">
            <div class="swiper-slide post w-full sm:w-[32%] sm:mr-[2%] p-4">
                <div class="post-header relative text-center">
                    <p class="absolute text-base xl:text-xl" set:html={post_especial[0].title.rendered}></p>
                    <img class="post-img" src="https://github.com/ecemgo/mini-samples-great-tricks/assets/13468728/defebc72-ea17-41c7-9bb6-70b3974a93b7" alt="recipe" /> 
                </div>   
                <div class="post-body">
                    <img class="post-avatar" src="https://stereociendigital.mx/wp-content/uploads/2022/09/especial.jpg" alt="avatar" />
                    <div class="post-detail">
                        <h2 class="post-name">El Especial de Stereo Cien</h2>
                        <!--p class="post-author">Evelyn Taylor</p-->
                    </div>
                    <div class="post-actions">
                        <a class="post-like" href="javascript:void(0)">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" width="48" height="48" stroke-width="2">
                            <path d="M10 18l6 -6l-6 -6v12"></path>
                            </svg>
                        </a>
                    </div>
                </div>
            </div>
            <div class="swiper-slide post w-full sm:w-[32%] sm:mr-[2%] p-4">
                <div class="post-header relative text-center">
                    <p class="absolute text-base xl:text-xl" set:html={post_mascotas[0].title.rendered}></p>
                    <img class="post-img" src="https://github.com/ecemgo/mini-samples-great-tricks/assets/13468728/defebc72-ea17-41c7-9bb6-70b3974a93b7" alt="recipe" /> 
                </div>   
                <div class="post-body">
                    <img class="post-avatar" src="https://stereociendigital.mx/wp-content/uploads/2022/09/podcast-mascotas.jpeg" alt="avatar" />
                    <div class="post-detail">
                        <h2 class="post-name">Mascotas con Estrella</h2>
                        <!--p class="post-author">Evelyn Taylor</p-->
                    </div>
                    <div class="post-actions">
                        <a class="post-like" href="javascript:void(0)">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" width="48" height="48" stroke-width="2">
                            <path d="M10 18l6 -6l-6 -6v12"></path>
                            </svg>
                        </a>
                    </div>
                </div>
            </div>
            <div class="swiper-slide post w-full sm:w-[32%] p-4">
                <div class="post-header relative text-center">
                    <p class="absolute text-sm md:text-base xl:text-xl" set:html={post_autos[0].title.rendered}></p>
                    <img class="post-img" src="https://github.com/ecemgo/mini-samples-great-tricks/assets/13468728/defebc72-ea17-41c7-9bb6-70b3974a93b7" alt="recipe" /> 
                </div>   
                <div class="post-body">
                    <img class="post-avatar" src="https://stereociendigital.mx/wp-content/uploads/2022/09/podcast-portada.jpg" alt="avatar" />
                    <div class="post-detail">
                        <h2 class="post-name">Autos al Cien</h2>
                        <!--p class="post-author">Evelyn Taylor</p-->
                    </div>
                    <div class="post-actions">
                        <a class="post-like" href="javascript:void(0)">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" width="48" height="48" stroke-width="2">
                            <path d="M10 18l6 -6l-6 -6v12"></path>
                            </svg>
                        </a>
                    </div>
                </div>
            </div>



      </div> 
    </div>
</div>

<style>
:root {
  --clr-text: hsl(0, 0%, 100%);
}

/** {
  box-sizing: border-box;
  padding: 0;
  margin: 0;
  font-family: "Quicksand", sans-serif;
}*/

.cont-pod {
  /*display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;*/
  width: 100%;
  /*padding: 60px;*/
  background: rgba(13,12,12,1);
  background: radial-gradient(
    circle,
    #044df1 5%,
    #031653 60%
  );
  border-radius: 25px;
}

.recipe-container {
  background: rgba(189, 181, 181, 0.1);
  box-shadow: 0 4px 30px rgba(0, 0, 0, 0.1);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1px solid rgba(255, 255, 255, 0.3);
  border-radius: 25px;
  /*width: min(1200px, 100%);*/
}

.post {
  max-width: 400px;
  font-size: 1rem;
  font-weight: 500;
  color: var(--clr-text);
  background: rgba(238, 239, 240, 0.2);
  box-shadow: 0 4px 30px rgba(0, 0, 0, 0.1);
  border-radius: 10px;
  padding: 16px 16px 0;
  margin-bottom: 16px;
}

.post-img {
  width: 100%;
  max-width: 400px;
  object-fit: cover;
  overflow: hidden;
  aspect-ratio: 4/3;
  border-radius: 6px;
  user-select: none;
  pointer-events: none;
}

.post-body {
  display: grid;
  grid-template-columns: 15% 60% 20%;
  align-items: center;
  gap: 8px;
  padding: 15px 0;
  cursor: default;
}

.post-name {
  font-size: 0.9rem;
  font-weight: 600;
  margin-bottom: 2px;
  overflow: hidden;
  text-overflow: ellipsis;
  line-height: 1;
  /*white-space: nowrap;*/
}

.post-author {
  width: fit-content;
  font-size: 0.8rem;
  font-weight: 600;
  opacity: 0.6;
  color: var(--clr-text);
}
.post-header{
    display: flex;
    align-items: center;
}
.post-header p{
    line-height: 1.25;
    margin-bottom: 0;
    font-size: 1.7vw; 
}
.post-header p::first-line {
  color: red;
  font-weight: bold;
  font-size: 2vw;
}



.post-avatar {
  width: 40px;
  aspect-ratio: 1/1;
  object-fit: cover;
  border-radius: 5px;
  cursor: pointer;
}

/*.post-actions {
  position: relative;
}

