---
export interface Props {
    post: {
      imagePath: string;
      title: {
         rendered: string;
      }
      content: string;
      excerpt:{
        rendered: string;
      }
      slug: string;
      categories : {};
      yoast_head_json: {
         og_image: [
            {
               url: string;
            }
         ]
         article_published_time: string;
         author:string;         
      }




    };
    
}

const { post } = Astro.props;

var url_seccion;
console.log(post.categories[0]);
switch (post.categories[0]){
    case 143:        
        url_seccion = 'culturapop';
    break;
    case 525:        
        url_seccion = 'librosycultura';
    break;
    case 524:
        url_seccion = 'seriesypeliculas';
    break;
    case 527:
        url_seccion = 'comidayguias';
    break;
    case 169:
        url_seccion = 'autos';
    break;
    case 167:
        url_seccion = 'mascotas';
    break;
    case 528:
        url_seccion = 'tecnologia';
    break;
    case 683:
        url_seccion = 'viajes';
    break;
    default:
        url_seccion = 'culturapop';    
    break;      
}


/*const section = post.yoast_head_json.schema['@graph'][0].articleSection; 
console.log(section);*/

---
          <article class="news-card transition duration-[0.2s] hover:translate-y-[-4px]">
            <a href={`/${url_seccion}/${post.slug}/`}>
              <div class="bg-black"><img src={post.yoast_head_json.og_image[0].url} alt="Imagen Noticias"/></div>
              <div class="news-content p-6">
                <h5 set:html={post.title.rendered}></h5>
                <div class="text-sm resumen" set:html={post.excerpt.rendered}></div>
                <span class="roboto font-bold text-xs mt-4">por {post.yoast_head_json.author}</span>
              </div>
            </a>  
          </article>


<style>
    .carduno img{
        box-shadow: none;
        width: 100%;
        height: 100%;
        mask-image: linear-gradient(225deg, hsla(var(--color-black), 1) 0, hsla(var(--color-black), 0.9) 40%, hsla(var(--color-black), 0) 80%);
        }

    .carduno h2, .carddos h2{
        display: -webkit-box;
        -webkit-margin-before: 0;
        margin-block-start: 0;
        -webkit-margin-after: 12px;
        margin-block-end: 12px;
        line-height: 1.2;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
</style>