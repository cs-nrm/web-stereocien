                <span class="roboto font-bold text-xs">por {posts[2].yoast_head_json.author}</span>
              </div>
            </a>  
          </article>

          <!-- Article 4 -->
          <article class="news-card hidden md:block lg:hidden transition duration-[0.2s] hover:translate-y-[-4px]">
            <a href={`/tecnologia/${posts[3].slug}/`}>
              <div class=""><img src={posts[3]._embedded['wp:featuredmedia'][0].media_details.sizes['stc-size'].source_url} alt="Imagen Las de Hoy"/></div>
              <div class="news-content p-6">
