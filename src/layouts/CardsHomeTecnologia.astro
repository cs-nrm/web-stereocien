              </div>
            </a>  
          </article>

          <!-- Article 3 -->
          <article class="news-card transition duration-[0.2s] hover:translate-y-[-4px]">
            <a href={`/tecnologia/${posts[2].slug}/`}>
              <div class=""><img src={posts[2]._embedded['wp:featuredmedia'][0].media_details.sizes['stc-size'].source_url} alt="Imagen Las de Hoy"/></div>
