---
import DoubleBox from '../components/DoubleBox.astro';
import BoxBanner from '../components/BoxBanner.astro';
import LeaderBoard from'../components/LeaderBoard.astro';
import SuperLeader from '../components/SuperLeader.astro';
import { Image } from 'astro:assets';


const res = await fetch("https://contenido.stereociendigital.mx/wp-json/wp/v2/posts?_fields=date,title,slug,sticky,yoast_head_json,content,excerpt,_links,_embedded&_embed&per_page=6&categories=528&order_by=date&order=desc");
const posts = await res.json();
---

      <div class="container cards">
        <h1 class="text-center p-4 my-4 font-bold text-xl md:text-2xl lg:text-4xl">Tecnología</h1>
        <div class="news-grid grid gap-4 grid-cols-1 md:grid-cols-2 lg:grid-cols-3 md:gap-16 xl:gap-16">
          <!-- Article 1 -->
          <article class="news-card transition duration-[0.2s] hover:translate-y-[-4px]">
            <a href={`/tecnologia/${posts[0].slug}/`}>
              <div class=""><img src={posts[0]._embedded['wp:featuredmedia'][0].media_details.sizes['stc-size'].source_url} alt="Imagen Las de Hoy"/></div>
              <div class="news-content p-6">
                <h5 set:html={posts[0].title.rendered}></h5>
                <div class="text-sm resumen" set:html={posts[0].excerpt.rendered}></div>
                <span class="roboto font-bold text-xs mt-4">por {posts[0].yoast_head_json.author}</span>
              </div>
            </a>  
          </article>

          <!-- Article 2 -->
          <article class="news-card transition duration-[0.2s] hover:translate-y-[-4px]">
            <a href={`/tecnologia/${posts[1].slug}/`}>
