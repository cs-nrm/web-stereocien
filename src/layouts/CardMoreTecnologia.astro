---
export interface Props {
    post: {
      imagePath: string;
      title: {
         rendered: string;
      }
      content: string;
      slug: string;
      categories : {};
      yoast_head_json: {
         og_image: [
            {
               url: string;
            }
         ]
         article_published_time: string;
         author:string;         
      }
    };
    
}

const { post } = Astro.props;

var url_seccion;
//console.log(post.categories[0]);
switch (post.categories[0]){
    case 143:        
        url_seccion = 'noticias';
    break;
    case 525:        
        url_seccion = 'libros';
    break;
    case 524:
        url_seccion = 'series-y-peliculas';
    break;
    case 527:
        url_seccion = 'guiasycomida';
    break;
    case 169:
        url_seccion = 'autos';
    break;
    case 526:
        url_seccion = 'vinos';
    break;
    case 167:
        url_seccion = 'mascotas';
    break;
    case 528:
        url_seccion = 'tecnologia';
    break;
    default:
        url_seccion = 'noticias';    
    break;      
}


---

<div class="card w-full p-4">
    <div class="overflow-hidden bg-zinc-800 hover:shadow-[0_2px_12px_6px_rgba(29,29,29,0.5)] group">
        <a href={`/${url_seccion}/${post.slug}/`}>
            <img class="block h-auto w-full aspect-video object-cover group-hover:text-[var(--amarillo-beat)]" src={post['_embedded']['wp:featuredmedia'][0].media_details.sizes['stc-size'].source_url} alt={post.title.rendered} />
        </a>
        <div class="flex items-center justify-between leading-tight px-2">
            <a class="no-underline" href={`/${url_seccion}/${post.slug}/`}>
                <h2 class="text-base text-gray-200 group-hover:text-[#ef4444] leading-normal" set:html={post.title.rendered}></h2>
            </a>
        </div>
        <div class="roboto flex items-center justify-between text-xs font-bold uppercase text-gray-500 px-2">            
            <p>{post.yoast_head_json.article_published_time.substring(0, 10)}</p>            
        </div>
    </div>
</div>
