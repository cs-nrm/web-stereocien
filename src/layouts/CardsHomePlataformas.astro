---
import DoubleBox from '../components/DoubleBox.astro';
import BoxBanner from '../components/BoxBanner.astro';
import LeaderBoard from'../components/LeaderBoard.astro';
import SuperLeader from '../components/SuperLeader.astro';
import { Image } from 'astro:assets';

const PLACEHOLDER_IMG = 'https://storage.googleapis.com/nrm-web/stereocien/img_stereocien-min.jpg';

const ressti = await fetch("https://stereociendigital.com.mx/wp-json/wp/v2/posts?_fields=date,title,slug,sticky,yoast_head_json,content,excerpt,acf,_links,_embedded&_embed&per_page=3&categories=524");

const posts = await ressti.json();

---
<div class="platforms-grid">
    <article>
        <a href={`/series-y-peliculas/${posts[0].slug}/`} class="group relative flex h-60 sm:h-48 items-end overflow-hidden shadow-lg md:h-96">
            <!--img src={post._embedded['wp:featuredmedia'][0].media_details.sizes['beat-news-size'].source_url} alt={post.title.rendered} class="absolute inset-0 h-full w-full object-cover object-center transition duration-200 group-hover:scale-110" /-->
            <img loading="lazy" src={posts[0]?.yoast_head_json.og_image?.[0]?.url || PLACEHOLDER_IMG} class="absolute inset-0 h-full w-full object-cover object-center transition duration-200 group-hover:scale-110" alt={posts[0]?._embedded?.['wp:featuredmedia']?.[0]?.alt_text||"Imagen Series y Películas"}/>
            <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-gray-800 via-transparent to-transparent opacity-50"></div>
            <div class="roboto"></div> 
            <div class="lovelo text relative inline-block p-3 text-lg sm:text-sm text-white md:text-xl leading-tight md:leading-none">
              <p class="mb-[15px]" set:html={posts[0].title.rendered}></p>
              <span class="roboto text-[#ef4444] text-base" set:html={posts[0].acf.plataforma}></span>
            </div>
        </a>
    </article>

    <article>
        <a href={`/series-y-peliculas/${posts[1].slug}/`} class="group relative flex h-60 sm:h-48 items-end overflow-hidden shadow-lg md:h-96">
            <!--img src={posts[1].yoast_head_json.og_image[0].url} alt={posts[1].title.rendered} class="absolute inset-0 h-full w-full object-cover object-center transition duration-200 group-hover:scale-110" /-->
            <img loading="lazy" src={posts[1]?.yoast_head_json.og_image?.[0]?.url || PLACEHOLDER_IMG} class="absolute inset-0 h-full w-full object-cover object-center transition duration-200 group-hover:scale-110" alt={posts[1]?._embedded?.['wp:featuredmedia']?.[0]?.alt_text||"Imagen Series y Películas"}/>
            <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-gray-800 via-transparent to-transparent opacity-50"></div>
            <div class="lovelo text relative inline-block p-3 text-lg sm:text-sm text-white md:text-xl leading-tight md:leading-none">
              <p class="mb-[15px]" set:html={posts[1].title.rendered}></p>
              <span class="roboto text-[#ef4444] text-base" set:html={posts[1].acf.plataforma}></span>
            </div>
        </a>
    </article>

    <article>
        <a href={`/series-y-peliculas/${posts[2].slug}/`} class="group relative flex h-60 sm:h-48 items-end overflow-hidden shadow-lg md:h-96">
            <img loading="lazy" src={posts[2]?.yoast_head_json.og_image?.[0]?.url || PLACEHOLDER_IMG} class="absolute inset-0 h-full w-full object-cover object-center transition duration-200 group-hover:scale-110" alt={posts[2]?._embedded?.['wp:featuredmedia']?.[0]?.alt_text||"Imagen Series y Películas"}/>
            <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-gray-800 via-transparent to-transparent opacity-50"></div>
            <div class="lovelo text relative inline-block p-3 text-lg sm:text-sm text-white md:text-xl leading-tight md:leading-none">
              <p class="mb-[15px]" set:html={posts[2].title.rendered}></p>
              <span class="roboto text-[#ef4444] text-base" set:html={posts[2].acf.plataforma}></span>
            </div>
        </a>
    </article>
</div>

<div class="m-auto text-center">
    <a href="/series-y-peliculas" class="hover:text-white">
        <button class="ver-mas lovelo group relative h-8 w-36 m-4 overflow-hidden bg-white hover:bg-[#ef4444] uppercase text-xs font-bold tracking-[3px]">
            <span>Ver más</span>
        </button>
    </a>
</div>

<style>

.platforms-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 2rem;
  align-items: center;
}

.platforms-grid article {
  background-color: #000;
}

.platforms-grid img {
  mask-image: linear-gradient(225deg, hsla(var(--color-black), 1) 0, hsla(var(--color-black), 0.9) 40%, hsla(var(--color-black), 0) 80%);
}

.platform-card {
  position: relative;
  overflow: hidden;
  border-radius: 0.5rem;
  background: #111;
  transition: transform 0.3s ease;
}

.platform-card:hover {
  transform: translateY(-4px);
}

.platform-card img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.platform-content {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 1.5rem;
  background: linear-gradient(to top, rgba(0,0,0,0.9), transparent);
}

.platform-content h3 {
  font-size: 1.25rem;
  font-weight: bold;
  margin-bottom: 0.5rem;
  color: white;
}

.platform-name {
  font-size: 0.875rem;
  color: #ef4444;
  text-transform: uppercase;
  font-family: 'Roboto';
}
@media (max-width: 640px) {
  .platforms-grid {
    grid-template-columns: repeat(1, 1fr);
  }
}
</style>