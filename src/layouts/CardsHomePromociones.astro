   ---
import DoubleBox from '../components/DoubleBox.astro';
import BoxBanner from '../components/BoxBanner.astro';
import LeaderBoard from'../components/LeaderBoard.astro';
import SuperLeader from '../components/SuperLeader.astro';
import { Image } from 'astro:assets';


const res = await fetch("https://stereociendigital.mx/wp-json/wp/v2/posts?_fields=title,date,slug,yoast_head_json,_links,_embedded&_embed&per_page=5&categories=275");

const posts = await res.json();

---
      <div class="container cards">
        <div class="grid gap-4 grid-cols-1 sm:grid-cols-2 md:gap-6 xl:gap-8">
          <div class="card">
              <a href={`/noticias/${posts[0].slug}/`} class="group relative flex h-60 sm:h-48 items-end overflow-hidden rounded-lg bg-gray-100 shadow-lg md:h-60">
                  <img src={posts[0].yoast_head_json['og_image'][0].url} alt={posts[0].title.rendered} class="absolute inset-0 w-full h-full object-cover object-center transition duration-200 group-hover:scale-110" />
                  <!--img src={posts[0]._embedded['wp:featuredmedia'][0].media_details.sizes['beat-news-size'].source_url} alt={posts[0].title.rendered} class="absolute inset-0 w-full h-full object-cover object-center transition duration-200 group-hover:scale-110" /-->
                  <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-gray-800 via-transparent to-transparent opacity-50"></div>
                  <div class="oswald w-full text relative inline-block p-3 text-base sm:text-sm md:text-lg text-white">
                    <p class="mb-0 leading-tight" set:html={posts[0].title.rendered}></p>
                    <span class="text-xs font-thin text-zinc-300" set:html={posts[0].yoast_head_json.article_published_time.substring(0, 10)}></span>
                  </div>
              </a>
          </div>
