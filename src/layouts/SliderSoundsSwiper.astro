.swiper {
  width: 100%;
  padding-bottom: 50px;
  padding-top: 15px;
}

.swiper-slide {
  width: 300px;
  height: 300px;
  filter: blur(1px);
  border-radius: 10px;
  display: flex;
  flex-direction: column;
  justify-content: end;
  align-items: self-start;
}
.swiper-slide img {
  box-shadow: 0 0 12px 4px rgba(0,0,0,0.4);
}
.swiper-slide-active {
  filter: blur(0px);
}

