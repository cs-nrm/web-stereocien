---
import BaseLayout from "./BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import BarNrm from "../components/BarNrm.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
import BarStereo from "../components/BarStereo.astro";
export interface Props {
    title: string;
    img: string;
    //categoria: string;
    //postslug: string;
    description: string;
    tags: {
        title: string;
        description: string;
        og_image: { url: string };
        og_description: string;
        og_locale: string;
        og_type: string;
        article_published_time: string;
        article_modified_time: string;
    };
}

const { title } = Astro.props;
const { img } = Astro.props;
const { tags } = Astro.props;
const { description } = Astro.props;
//const { categoria } = Astro.props;
//const { postslug } = Astro.props;
//const canonicalURL = new URL(Astro.url.pathname, Astro.site); // Now handled in BaseLayout
---

<BaseLayout title={title} description={description} tags={tags}>
    <BarStereo />
    <Header title={title} />

    <main class="min-h-screen flex flex-col">
        <slot />
    </main>

    <Footer />
</BaseLayout>
