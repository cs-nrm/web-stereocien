---
import DoubleBox from '../components/DoubleBox.astro';
import BoxBanner from '../components/BoxBanner.astro';
import LeaderBoard from'../components/LeaderBoard.astro';
import SuperLeader from '../components/SuperLeader.astro';
import { Image } from 'astro:assets';

const PLACEHOLDER_IMG = 'https://storage.googleapis.com/nrm-web/stereocien/img_stereocien-min.jpg';
const res = await fetch("https://stereociendigital.com.mx/wp-json/wp/v2/sounds?per_page=100&orderby=sounds_order&order=asc");
const posts = await res.json();

---
<div class="slider-sounds">
	<div class="carousel main-carousel-sounds cards promos">

	{
	posts.map((post:any)=> (
		<div id={`sounds-${post.slug}`} class="carousel-cell card">
			<article>
				<Image loading="lazy" class="rounded-full block h-auto w-full object-fill" src={post?.sounds_logo_url || PLACEHOLDER_IMG} alt={post?._embedded?.['wp:featuredmedia']?.[0]?.alt_text||"Imagen Relojes"} width="300" height="150"/>
			</article>
		</div>
	))    
	}
	</div> 


	<!--div class="carousel carousel-nav">
	{
	posts.map((post:any)=> (
		<div class="carousel-cell">
			<Image class="block h-auto w-full object-fill" src={post._embedded['wp:featuredmedia'][0].media_details.sizes['thumbnail'].source_url} width="150" height="150" alt={post.title.rendered}/>
