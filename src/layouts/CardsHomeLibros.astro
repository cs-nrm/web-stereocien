---
import DoubleBox from '../components/DoubleBox.astro';
import BoxBanner from '../components/BoxBanner.astro';
import LeaderBoard from'../components/LeaderBoard.astro';
import SuperLeader from '../components/SuperLeader.astro';
import { Image } from 'astro:assets';

const PLACEHOLDER_IMG = 'https://storage.googleapis.com/nrm-web/stereocien/img_stereocien-min.jpg';
const ressti = await fetch("https://stereociendigital.com.mx/wp-json/wp/v2/posts?_fields=date,title,slug,sticky,yoast_head_json,content,excerpt,_links,_embedded&_embed&per_page=1&categories=525");

const posts = await ressti.json();

---
<a href={`/libros/${posts[0].slug}/`}>
 <div class="review-container">
    <div class="book-cover">
      <!--img src={posts[0]._embedded['wp:featuredmedia'][0].media_details.sizes['full'].source_url} alt=""-->
      <img loading="lazy" class="h-auto w-full" src={posts[0]?._embedded?.['wp:featuredmedia']?.[0]?.media_details?.sizes?.['full']?.source_url|| PLACEHOLDER_IMG} alt={posts[0]?._embedded?.['wp:featuredmedia']?.[0]?.alt_text||"Imagen Libros"}/>
    </div>
    <div class="review-content">
        <span class="category lovelo">RESEÑAS</span>
        <h2 set:html={posts[0].title.rendered}></h2>
        <div class="resumen" ><p set:html={posts[0].excerpt.rendered}></p></div>
        <span class="author roboto font-bold">por {posts[0].yoast_head_json.author}</span>
    </div>
  </div>
</a>


<style>
.review-container {
  display: grid;
  grid-template-columns: 1fr 1fr;
  background: #f5f3e7;
  margin-top: 4rem;
  align-items: center;
}

.review-content {
  padding: 3rem;
  display: flex;
  flex-direction: column;
  justify-content: center;
  max-width: 600px;
  margin: 0 auto;
  text-align: center;
}

.review-content .category {
  font-size: 0.875rem;
  font-weight: 500;
  margin-bottom: 1.5rem;
  text-transform: uppercase;
}

.review-content h2 {
  font-size: 2.5rem;
  font-weight: bold;
  line-height: 1.2;
  margin-bottom: 1.5rem;
  text-transform: uppercase;
}

.review-content p {
  font-size: 1.125rem;
  line-height: 1.6;
  margin-bottom: 1.5rem;
  color: #333;
}

.review-content .author {
  font-size: 0.875rem;
  color: #666;
}

.book-cover {
  display: flex;
  align-items: center;
  justify-content: center;
}

.book-cover img {
  /*filter: grayscale(100%);*/
  transition: filter 0.3s ease;
}

.book-cover img:hover {
  /*filter: grayscale(0);*/
}
@media (min-width: 769px){
  .book-cover img {max-width: 400px; height: auto;}
}
@media (max-width: 900px) {
  .review-container{min-height: auto;}
  .review-content {padding: 1rem;}
  .review-content p{display: none;  }
}
@media (max-width: 1280px) {
  .review-content h2{font-size: 2rem;}
}
@media (max-width: 640px) {
  .review-content h2{font-size: 1.5rem;}
  .review-content .author, .review-content .category{ font-size: 0.6rem;}
}
</style>