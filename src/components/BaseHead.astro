---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import '../styles/global.css';
import AdScripts from './head/AdScripts.astro';
import AnalyticsScripts from './head/AnalyticsScripts.astro';

interface Props {
	title: string;
	description: string;
	image?: string;
	seccion: string;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const { title, description, image = '/stereocien-share1001.jpg', seccion } = Astro.props;
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="apple-touch-icon" sizes="180x180" href="/favicon/apple-touch-icon.png">
<link rel="icon" type="image/png" sizes="32x32" href="/favicon/favicon-32x32.png">
<link rel="icon" type="image/png" sizes="16x16" href="/favicon/favicon-16x16.png">
<link rel="manifest" href="/favicon/site.webmanifest">
<link rel="mask-icon" href="/favicon/safari-pinned-tab.svg" color="#5bbad5">
<meta name="msapplication-TileColor" content="#2b5797">
<meta name="theme-color" content="#000">

<!-- Font preloads -->
<!--link rel="preload" href="/fonts/atkinson-regular.woff" as="font" type="font/woff" crossorigin />
<link rel="preload" href="/fonts/atkinson-bold.woff" as="font" type="font/woff" crossorigin /-->

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{seccion} - {title} </title>
<meta name="title" content={title} />
<meta name="description" content={description} />
<meta name="author" content='Stereo Cien' />
<meta name="publisher" content='NRM Comunicaciones' />
<meta http-equiv="Content-Language" content="es">

<!-- Open Graph / Facebook -->
<!--meta property="og:title" content={title} >
<meta property="og:description" content={description} />
<meta property="og:image" content='' />
<meta property="og:url" content="https://stereociendigital.mx">
<meta property="og:type" content="website"-->

<!-- Twitter -->
<!--meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={Astro.url} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta name="twitter:site" content="@stereocienmx">
<meta property="twitter:image" content={new URL(image, Astro.url)} /-->

<!-- sitemap -->
<link rel="sitemap" href="/sitemap.xml" />
<meta name="robots" content="index, follow">

<AdScripts />
<AnalyticsScripts />