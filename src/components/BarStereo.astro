---
const currentPath = Astro.url.pathname;
---

<div class="hidden md:flex bar-stereo is-pinned">
    <div class="white-space sec-menu"></div>
    <div class="logo sec-menu"><a href="/"><img src="https://storage.googleapis.com/nrm-web/oye/recursos/logo-stereocien-2025%20.svg" /></a></div>
    <div class="header-buttons sec-menu">
      <div class="relative flex items-center gap-1 justify-end z-0">  
        <input type="checkbox" id="hamburger-check" class="peer hidden"/> 
        <label class="radio-button" for="hamburger-check">
          <svg xmlns="https://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4.9 19.1C1 15.2 1 8.8 4.9 4.9"/><path d="M7.8 16.2c-2.3-2.3-2.3-6.1 0-8.5"/><circle cx="12" cy="12" r="2"/><path d="M16.2 7.8c2.3 2.4 2.3 6.2 0 8.5"/><path d="M19.1 4.9C23 8.8 23 15.1 19.1 19"/></svg>
          Radio
        </label> 
        <label class="hidden peer-checked:block cursor-pointer flex flex-col items-center justify-center" for="hamburger-check">
          <!--div class="bg-[#ef4444] h-1 w-6 mt-1 rotate-45 translate-y-[-4px]"></div>
          <div class="bg-[#ef4444] h-1 w-6 mt-1 -rotate-45 -translate-y-[14px] "></div-->
          <svg xmlns="https://www.w3.org/2000/svg" class="flecha-svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#01216b" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
            <path d="M6 15l6 -6l6 6" />
          </svg>
        </label>
        <label class="block peer-checked:hidden cursor-pointer flex flex-col items-center justify-center transform duration-3000" for="hamburger-check">
          <!--div class="bg-[#ef4444] hover:bg-[#f87171] h-1 w-6 mt-1"></div>
          <div class="bg-[#ef4444] hover:bg-[#f87171] h-1 w-6 mt-1"></div>
          <div class="bg-[#ef4444] hover:bg-[#f87171] h-1 w-6 mt-1"></div-->
          <svg xmlns="https://www.w3.org/2000/svg" class="flecha-svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#01216b" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
            <path d="M6 9l6 6l6 -6" />
          </svg>
        </label>  
    
        <div class="hidden z-10 peer-checked:table rounded absolute w-full p-4 bg-black top-10 right-0">
          <ul class="hh flex flex-row justify-center items-center gap-2">
            <li class={`menu-section${currentPath.startsWith('/en-vivo') ? ' active' : ''}`}><a href="/en-vivo" class="text-xs sm:text-base flex flex-nowrap flex-row items-center text-white gap-2 hover:text-#ef4444"><span class="live-icon"></span> <span class="min-w-[60px] sm:min-w-[85px]">En Vivo</span></a></li>
            <li class={`menu-section${currentPath.startsWith('/programacion') ? ' active' : ''}`}><a href="/programacion" class="text-xs sm:text-base flex flex-nowrap items-center text-white gap-2 hover:text-#ef4444"><svg xmlns="https://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" width="24" height="24" stroke-width="2">
              <path d="M4 7a2 2 0 0 1 2 -2h12a2 2 0 0 1 2 2v12a2 2 0 0 1 -2 2h-12a2 2 0 0 1 -2 -2v-12z"></path>
              <path d="M16 3v4"></path>
              <path d="M8 3v4"></path>
              <path d="M4 11h16"></path>
              <path d="M7 14h.013"></path>
              <path d="M10.01 14h.005"></path>
              <path d="M13.01 14h.005"></path>
              <path d="M16.015 14h.005"></path>
              <path d="M13.015 17h.005"></path>
              <path d="M7.01 17h.005"></path>
              <path d="M10.01 17h.005"></path>
            </svg> <span>Programación</span></a></li>
            <li class={`menu-section${currentPath.startsWith('/noticiero') ? ' active' : ''}`}><a href="https://enfoquenoticias.com.mx/" target="_blank" class="text-xs sm:text-base flex flex-nowrap items-center text-white gap-2 hover:text-#ef4444">
            <svg xmlns="https://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1" stroke-linecap="round" stroke-linejoin="round">
              <path d="M16 6h3a1 1 0 0 1 1 1v11a2 2 0 0 1 -4 0v-13a1 1 0 0 0 -1 -1h-10a1 1 0 0 0 -1 1v12a3 3 0 0 0 3 3h11" />
              <path d="M8 8l4 0" />
              <path d="M8 12l4 0" />
              <path d="M8 16l4 0" />
            </svg><span>Enfoque</span></a></li>
          </ul>
        </div>
      </div>
        <!--span class="text-xs text-white to-dark">Escuchar:</span>
      <button class="radio-button">
        <span class="live-icon"></span>
        <a href="/en-vivo">Radio en Vivo </a>
      </button>
      <a target="_blank" href=="https://enfoquenoticias.com.mx/"><button class="radio-button text-xs text-white to-dark">Noticias</button></a-->
    </div>
</div>
