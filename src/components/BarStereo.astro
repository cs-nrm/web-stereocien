<style>
.flecha-svg{
  transition: transform .4s;
}
.bar-stereo {
  background: white;
  padding: 1rem 1.5rem;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  font-family: 'Roboto';
  overflow: hidden;
  position: sticky;
  top: -1px;
  z-index: 10001;
  /*height: 140px;*/
  transition: height 0.5s;
  overflow: initial;
}
.bar-stereo-mobile {
  background: white;
  padding: 1rem 1.5rem;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  font-family: 'Roboto';
  overflow: hidden;
  position: sticky;
  top: -1px;
  z-index: 10001;
  height: 50px;
  overflow: initial;
}
.bar-stereo-mobile .logo img{
  height: 50px !important;
}

.sec-menu{width: 50%;}

.header-white {background: white; color: black; transition: all 0.2s;}

.compress{  height: 50px; transition: height 0.5s; position: fixed; width: 100%;}

.logo {
  font-size: 1.5rem;
  font-weight: bold;
  display: flex;
  justify-content: center;
}

.logo img{
  height: 110px;
  transition: all 0.5s;
}

.compress-logo img{
  height: 50px;
  transition: all 0.5s;
}

.header-buttons {
  display: flex;
  align-items: center;
  gap: 0rem;
  justify-content: end;
}

li a:hover{
  color: #717171;
}

/*button {
  background: none;
  border: none;
  color: white;
  font-family: inherit;
  font-size: 0.9rem;
  cursor: pointer;
  padding: 0.5rem;
  padding-top: 0.8rem;
  transition: color 0.2s;
}

button:hover {
  color: #d1d1d1;
}*/

.dark-mode{
    color:black;
    transition: all 0.2s;
    stroke: black;
}

.logo-dark-mode{
  filter: invert(80%);
  
  transition: all 0.4s;
}

.radio-button {
  color: #01216b;
  display: flex;
  align-items: center;
  gap: 0.5rem;
  font-size: 17px;
  font-weight: bold;
  cursor: pointer;
  padding: 0.5rem;
  padding-top: 0.8rem;
  transition: color 0.2s;
}

.radio-button:hover {
  color: #717171;
}

@media (max-width: 1024px) {
    .white-space{
        display: none;
    }
    .logo{
        justify-content: flex-start;
    }
}
@media (max-width: 450px) {
  .hh{flex-direction: column; align-items: flex-end;}
}

.live-icon {
    display: inline-block;
    position: relative;
    top: calc(50% - 5px);
    background-color: #ef4444;
    width: 10px;
    height: 10px;
    margin-right: 5px;
    border: 1px solid rgba(0, 0, 0, 0.1);
    border-radius: 50%;
    z-index: 1;
}
.live-icon:before {
    content: "";
    display: block;
    position: absolute;
    background-color: rgba(255, 0, 0, 0.6);
    width: 100%;
    height: 100%;
    border-radius: 50%;
    -webkit-animation: live 2s ease-in-out infinite;
    animation: live 2s ease-in-out infinite;
    z-index: -1;
}
@keyframes live {
  0% {
    transform: scale(1, 1);
  }
  100% {
    transform: scale(3.5, 3.5);
    background-color: rgba(red, 0);
  }
}

</style>