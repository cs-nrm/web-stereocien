---
/**
 * Renderizador del contenido Lexical de `noticias.contenido`.
 *
 * Heredado de web-beat, que lo escribió contra el ÁRBOL REAL de las notas y no
 * contra los tipos: `noticias.contenido` está tipado suelto en
 * `src/types/payload.ts` (los hijos son `unknown`), así que los tipos no dicen qué
 * nodos existen. Contados el 2026-09-28 en las 145 notas de Beat: `paragraph`,
 * `heading`, `text`, `block` (embed), `upload`, `linebreak` y `link`. Los de lista,
 * cita y regla se cubren porque el editor los ofrece. Las notas de Stereo Cien
 * llegan de WordPress por el importador del CMS, que pasa el HTML por
 * `convertHTMLToLexical` y arma a mano las imágenes y los embeds: los mismos
 * nodos. Medido el 2026-09-28 en las 50 entradas más recientes de ese WordPress:
 * 28 iframes de YouTube (salen como `block` de embed), 4 `<br>` (en una sola
 * entrada) y 32 enlaces absolutos al propio dominio —ver `esExterno`—.
 *
 * Nada de `set:html` con contenido del CMS. El texto sale como texto y el
 * formato como etiquetas, así que un `<script>` escrito en el editor se ve como
 * las letras que es.
 *
 * NO TRAE ESTILO DE DISEÑO, a propósito: emite etiquetas semánticas con clases
 * `lx-*` estables y quien lo usa las estila desde su contenedor
 * (`.cuerpo :global(.lx-p)`, o una hoja global). El único CSS de aquí es el que
 * evita que una imagen desborde su columna. Las clases:
 *
 *   p.lx-p                     párrafo (la entrada es `.lx-p:first-child`)
 *   h2|h3|h4|h5|h6.lx-h        encabezado; `.es-menor` si el editor eligió h3 o menos
 *   blockquote.lx-cita > p     cita
 *   ul.lx-lista | ol.lx-lista  lista, con `li` sin clase
 *   figure.lx-figura > img + figcaption   imagen del cuerpo; el pie es su `alt`
 *   hr.lx-regla                separador
 *   a                          enlace, sin clase; los externos llevan `target` y `rel`
 *   strong, em, s, u, code     formato de texto, anidados
 *   br                         salto de línea dentro de un párrafo o un `li`
 *   figure.embed-bloque | p.embed-suelto   los embeds, ver `Embed.astro`
 */
import Embed from './Embed.astro';
import { urlMedia, type DocMedia } from '@/lib/cms/client';
import { HOST_CANONICO, rutaNota } from '@/config/site';
import { hrefSeguro } from '@/lib/enlaces';

interface Props {
  contenido: unknown;
}

const { contenido } = Astro.props;

/** Nodo de Lexical, con lo que este renderizador consulta de verdad. */
interface Nodo {
  type?: string;
  tag?: string;
  text?: string;
  format?: number | string;
  listType?: string;
  children?: Nodo[];
  fields?: Record<string, unknown>;
  relationTo?: string;
  value?: unknown;
}

const raiz = (contenido as { root?: Nodo } | null)?.root;
const nodos: Nodo[] = raiz?.children ?? [];

/**
 * El texto de un nodo y de todo lo que lleva dentro, a cualquier profundidad.
 *
 * Existe porque un enlace guarda su texto en sus HIJOS, no en `text`: leer solo el
 * primer nivel de un encabezado o una cita que lleva un enlace se comía esas
 * palabras sin error.
 */
function textoDe(n: Nodo): string {
  if (typeof n.text === 'string') return n.text;
  if (n.type === 'linebreak') return ' ';
  return (n.children ?? []).map(textoDe).join('');
}

/**
 * ¿El nodo aporta algo? Los párrafos VACÍOS son comunes —heredado de web-beat:
 * la nota que se inspeccionó allá traía 4 de 11— porque el editor los deja al
 * separar bloques. Pintarlos como `<p>` mete huecos de un margen cada uno en mitad
 * del texto. Un párrafo que solo tiene saltos de línea también está vacío.
 */
function tieneSustancia(n: Nodo): boolean {
  if (n.type === 'upload' || n.type === 'block' || n.type === 'horizontalrule') return true;
  return textoDe(n).trim().length > 0;
}

const visibles = nodos.filter(tieneSustancia);

/** Bits de formato de Lexical. Solo los que el editor del CMS puede producir. */
const NEGRITA = 1;
const CURSIVA = 2;
const TACHADO = 4;
const SUBRAYADO = 8;
const CODIGO = 16;

function marcas(f: unknown): string[] {
  const n = typeof f === 'number' ? f : 0;
  const t: string[] = [];
  if (n & NEGRITA) t.push('strong');
  if (n & CURSIVA) t.push('em');
  if (n & TACHADO) t.push('s');
  if (n & SUBRAYADO) t.push('u');
  if (n & CODIGO) t.push('code');
  return t;
}

/**
 * ¿Es un enlace? `autolink` es el que el editor crea solo al pegar una URL: lleva
 * la URL en `fields.url` igual que un `link`, y sin tratarlo aquí su texto se
 * perdía entero.
 */
function esEnlace(n: Nodo): boolean {
  return n.type === 'link' || n.type === 'autolink';
}

/**
 * El `href` de un nodo de enlace, ya sea externo o a un documento del CMS.
 *
 * No romper: la URL capturada pasa por `hrefSeguro` (src/lib/enlaces.ts), la lista
 * CERRADA de esquemas, antes de llegar a un `href`. El texto del enlace sí se pinta
 * —como texto— aunque la URL se descarte.
 */
function hrefDe(n: Nodo): string | null {
  const f = (n.fields ?? {}) as { url?: string; linkType?: string; doc?: unknown };
  if (f.linkType === 'internal') {
    const doc = f.doc as { value?: { slug?: string }; relationTo?: string } | undefined;
    const slug = doc?.value?.slug;
    // Solo `noticias` por ahora: es la única ruta de detalle que existe.
    return slug && doc?.relationTo === 'noticias' ? rutaNota(slug) : null;
  }
  return hrefSeguro(f.url);
}

/**
 * Un enlace que sale del sitio abre en otra pestaña y lleva `rel`; uno del propio
 * sitio, no.
 *
 * El dominio propio cuenta como interno aunque venga absoluto, y es por la
 * migración: las notas del WordPress enlazan entre sí con la URL completa
 * (`https://stereociendigital.mx/<seccion>/<slug>/`; 32 enlaces así en las 50
 * entradas más recientes, medido el 2026-09-28), y sin esto cada enlace a otra
 * nota de la casa se abriría en una pestaña nueva. La URL se deja como viene: el
 * 301 del sitio viejo la lleva a su `/noticias/<slug>`.
 */
function esExterno(href: string): boolean {
  let u: URL;
  try {
    u = new URL(href);
  } catch {
    return false; // relativo: es de este sitio
  }
  if (u.protocol !== 'http:' && u.protocol !== 'https:') return false;
  const host = u.hostname.toLowerCase().replace(/^www\./, '');
  return host !== HOST_CANONICO;
}
---

{
  visibles.map((n) => {
    switch (n.type) {
      case 'heading': {
        /*
          ESTRUCTURA y ESTILO se deciden por separado, y no es rebuscado:
          apuntan a cosas distintas.

          La ESTRUCTURA baja un nivel, porque el titular de la nota ya es el `h1`
          del documento y un segundo `h1` rompe el esquema para lectores de
          pantalla y para Google.

          El ESTILO va por el nivel que el editor eligió, no por la etiqueta que
          sale: por eso `.es-menor` marca los que el editor escribió como h3 o
          menos. Si se estilara por la etiqueta, el encabezado principal del
          cuerpo —que la redacción escribe como `h2`— saldría `h3` y se pintaría
          como un subtítulo (heredado de web-beat, donde se midió).
        */
        const original = Number((n.tag ?? 'h2').slice(1)) || 2;
        const nivel = Math.min(original + 1, 6);
        const Tag = `h${nivel}` as 'h2' | 'h3' | 'h4' | 'h5' | 'h6';
        return (
          <Tag class:list={['lx-h', { 'es-menor': original >= 3 }]}>
            <Fragment set:text={textoDe(n)} />
          </Tag>
        );
      }

      case 'quote':
        return (
          <blockquote class="lx-cita">
            <p>
              <Fragment set:text={textoDe(n)} />
            </p>
          </blockquote>
        );

      case 'list': {
        const Tag = n.listType === 'number' ? 'ol' : 'ul';
        return (
          <Tag class="lx-lista">
            {(n.children ?? []).map((li) => (
              <li>
                {(li.children ?? []).map((t) => {
                  if (t.type === 'linebreak') return <br />;
                  const href = esEnlace(t) ? hrefDe(t) : null;
                  const texto = textoDe(t);
                  if (!href) return <Fragment set:text={texto} />;
                  const externo = esExterno(href);
                  return (
                    <a
                      href={href}
                      target={externo ? '_blank' : undefined}
                      rel={externo ? 'noopener noreferrer' : undefined}
                      set:text={texto}
                    />
                  );
                })}
              </li>
            ))}
          </Tag>
        );
      }

      case 'upload': {
        /*
          Trampa: el importador del CMS guarda la imagen como un id (`value: 12`), y
          solo llega como documento si la consulta pidió profundidad. `obtenerNota`
          pide `depth: 2`; con menos, `value` es un número y la imagen no se pinta.
        */
        if (n.relationTo !== 'media' || typeof n.value !== 'object' || n.value === null) return null;
        const media = n.value as DocMedia;
        const src = urlMedia(media, 'large');
        if (!src) return null;
        return (
          <figure class="lx-figura">
            <img src={src} alt={media.alt ?? ''} loading="lazy" decoding="async" />
            {media.alt && <figcaption>{media.alt}</figcaption>}
          </figure>
        );
      }

      case 'block': {
        /*
          Solo el bloque `embed`. El CMS ofrece también `galeria` y `formulario`, y
          esos hoy NO se pintan: quedan fuera sin aviso.
        */
        const f = (n.fields ?? {}) as { blockType?: string; plataforma?: string; url?: string };
        if (f.blockType !== 'embed') return null;
        return <Embed plataforma={f.plataforma as never} url={f.url} />;
      }

      case 'horizontalrule':
        return <hr class="lx-regla" />;

      case 'paragraph':
      default:
        return (
          <p class="lx-p">
            {(n.children ?? []).map((h) => {
              /*
                Un salto de línea es un nodo propio, sin texto. Sin este caso se
                perdía y las dos líneas quedaban pegadas —«fin de línea» y «Siguiente»
                como «fin de líneaSiguiente»—. Es el nodo en que Lexical convierte un
                `<br>` del HTML, y en las notas de Beat ya había 4.
              */
              if (h.type === 'linebreak') return <br />;
              // Un enlace trae su propio texto adentro, con su propio formato.
              if (esEnlace(h)) {
                const href = hrefDe(h);
                const texto = textoDe(h);
                if (!href) return <Fragment set:text={texto} />;
                const externo = esExterno(href);
                return (
                  <a
                    href={href}
                    target={externo ? '_blank' : undefined}
                    rel={externo ? 'noopener noreferrer' : undefined}
                    set:text={texto}
                  />
                );
              }
              /*
                Nodo de texto: se envuelve en tantas etiquetas como marcas traiga.

                Se anidan con componentes explícitos y no con un `reduce` sobre
                elementos JSX (heredado de web-beat): aquello necesitaba un `as
                unknown as astroHTML.JSX.Element` para compilar, y el compilador de
                Astro 7 ya no acepta ese cast dentro de una expresión de plantilla.
                Además el bitmask de Lexical solo combina cinco marcas, así que
                anidar a mano es más claro que acumular.
              */
              const texto = h.text ?? '';
              const etiquetas = marcas(h.format);
              if (!etiquetas.length) return <Fragment set:text={texto} />;
              // De dentro hacia fuera: la primera marca queda más pegada al texto.
              // Los `as` aquí NO pueden llevar una unión: un cast con `|` dentro
              // de una expresión de plantilla no lo parsea el compilador de Astro.
              const Primera = etiquetas[0] as 'strong';
              let salida = <Primera set:text={texto} />;
              for (let i = 1; i < etiquetas.length; i++) {
                const Siguiente = etiquetas[i] as 'strong';
                salida = <Siguiente>{salida}</Siguiente>;
              }
              return salida;
            })}
          </p>
        );
    }
  })
}

<style>
  /* Lo único estructural: una imagen del cuerpo nunca desborda su columna. El
     resto del aspecto lo pone el contenedor de quien usa este componente. */
  .lx-figura img {
    display: block;
    width: 100%;
    height: auto;
  }
</style>
