<!-- Smart AdServer / Equativ (Medios Federales, red 4308): formato Inline del Inicio,
     contenedor en src/components/SmartInline.astro. Fragmento de MF del 14 nov 2026
     (siteId 794551, pageId 2249306), adaptado:
     - is:inline en todo: sin él Astro lo vuelve módulo, "sas" deja de ser global y
       smart.js nunca ve la cola sas.cmd.
     - Los externos y sas.setup corren una sola vez; el onecall y el render se repiten en
       cada astro:page-load, porque con el ClientRouter la página no se recarga.
     - trampa: el fragmento traía tagId "inline" pero div y render "Inline"; los ids
       distinguen mayúsculas y el anuncio no encontraba dónde pintarse. Aquí es "inline"
       en los tres lugares.
     - Su "let dominio" de nivel superior truena si el script vuelve a correr ("already
       been declared"), y el target iba sin codificar.
     - Se quitó su mobileCheck(): las ramas de móvil y escritorio pedían exactamente el
       mismo formato. Si MF separa formatos por dispositivo, ahí vuelve a hacer falta. -->
<script is:inline async src="https://ced.sascdn.com/tag/4308/smart.js"></script>
<script is:inline async src="https://tagmanager.smartadserver.com/4308/790083/smart.prebid.js"></script>
<script is:inline>
  window.sas = window.sas || {};
  window.sas.cmd = window.sas.cmd || [];
  // Guarda por si el ClientRouter vuelve a ejecutar el head: setup y listeners, una vez.
  if (!window._sasListo) {
    window._sasListo = true;
    window.sas.cmd.push(function () {
      window.sas.setup({ networkid: 4308, domain: 'https://adapi.smartadserver.com', async: true, renderMode: 2 });
    });

    var sasInlineCerrado = function () {
      try { return sessionStorage.getItem('sasInlineCerrado') === '1'; } catch (e) { return false; }
    };

    document.addEventListener('astro:page-load', function () {
      var caja = document.getElementById('smart-inline');
      var holder = document.getElementById('inline');
      // Solo en las páginas que traen el contenedor (hoy, el Inicio).
      if (!caja || !holder) return;
      // Si lo cerró en esta sesión, ni se pide.
      if (sasInlineCerrado()) return;

      // El recuadro se muestra mientras el div mide algo: el video desplegado mide
      // 162-168px de alto; sin anuncio, o ya plegado, mide 0 o 1. No contar hijos: Smart
      // mete sus <script> en el div aunque no haya video (ver SmartInline.astro).
      if (window._sasInlineObs) window._sasInlineObs.disconnect();
      window._sasInlineObs = new ResizeObserver(function () {
        caja.classList.toggle('con-anuncio', holder.offsetHeight > 20);
      });
      window._sasInlineObs.observe(holder);

      window.sas.cmd.push(function () {
        window.sas.call('onecall', {
          siteId: 794551,
          pageId: 2249306,
          formats: [{ id: 111268, tagId: 'inline' }],
          // target es clave=valor;clave=valor: una URL con & o = sin codificar lo rompe.
          target: 'dominio=' + encodeURIComponent(location.href),
          schain: '1.0,1!mediosfederales.com,794551,1,stereociendigital.mx,stereociendigital.mx'
        });
        // renderMode 2 = render manual, por eso hace falta llamar render().
        window.sas.render('inline');
      });
    });

    // Cerrar, delegado: el recuadro es otro nodo en cada navegación.
    document.addEventListener('click', function (e) {
      if (!e.target || !e.target.closest || !e.target.closest('#smart-inline-cerrar')) return;
      var caja = document.getElementById('smart-inline');
      var holder = document.getElementById('inline');
      if (window._sasInlineObs) window._sasInlineObs.disconnect();
      if (caja) {
        caja.classList.remove('con-anuncio');
        caja.classList.add('cerrado');
      }
      // Vaciar el div corta el video; oculto con display:none seguiría sonando.
      if (holder) holder.innerHTML = '';
      try { sessionStorage.setItem('sasInlineCerrado', '1'); } catch (err) {}
    });
  }
</script>
