   <div id="ad-slot3" class="hidden md:block">
	<script defer is:inline>
	  var gptAdSlots3 = [];
	  googletag.cmd.push(function() {
 	    var mapping3 = googletag.sizeMapping().
	    //addSize([970, 250]).
		addSize([728, 90]).
	    build();
	    //var slot3 = googletag.defineSlot("/21799830913/StereoCien", [728, 250],'ad-slot3').
		var slot3 = googletag.defineSlot("/21799830913/StereoCien", [728, 90],'ad-slot3').
	    defineSizeMapping(mapping3).
	    addService(googletag.pubads());
	    googletag.pubads().setTargeting("test","responsive");
	    googletag.enableServices();
	    googletag.display('ad-slot3');
	    googletag.pubads().refresh([slot3]);
	    //setInterval(function(){googletag.pubads().refresh([slot3]);}, 180000);
	  });
	</script>
   </div>

   <div id="ad-slot31" class="block md:hidden">
