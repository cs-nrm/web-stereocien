---
/**
 * La tornamesa de la barra: el vinilo con la etiqueta de Stereo Cien y el brazo
 * (§5.1, punto 3 del handoff).
 *
 * Es un DIBUJO, no contenido: va entera con `aria-hidden` y sin nada enfocable.
 * Lo que dice —la estación y la frecuencia— ya lo dicen en texto la barra y la
 * cabecera. Por eso el «100.1» de la etiqueta puede encogerse por debajo de 12 px
 * cuando la tornamesa se achica: es parte de la ilustración, no un texto que
 * alguien tenga que leer.
 *
 * Se dibuja en CSS, igual que en los tableros, sobre una caja base de 250 px que
 * se ESCALA entera (`--tt-escala`) para cada tamaño del §5.5. Así las medidas del
 * brazo y de la etiqueta se escriben una sola vez y no se descuadran al achicar.
 *
 * HOY NO GIRA, y es a propósito: no suena nada. El diseño la hace girar y mete el
 * brazo al disco —de `rotate(-4deg)` a `rotate(7deg)`— mientras hay audio; eso se
 * enciende cuando exista el reproductor, desde la barra (un atributo en un
 * ancestro), y entonces tendrá que respetar `prefers-reduced-motion`. Mientras no
 * hay audio, un disco girando afirmaría que algo suena.
 */
interface Props {
  /** La frecuencia de la etiqueta, sin «FM»: «100.1». */
  frecuencia: string;
}

const { frecuencia } = Astro.props;
---

<div class="tornamesa" aria-hidden="true">
  <div class="tornamesa-plato">
    <div class="vinilo">
      <div class="etiqueta">
        <img
          class="etiqueta-logo"
          src="/img/stereocien.svg"
          alt=""
          width="64"
          height="21"
          decoding="async"
        />
        <span class="etiqueta-eje"></span>
        <span class="etiqueta-frecuencia">{frecuencia}</span>
      </div>
    </div>
    <div class="vinilo-brillo"></div>
    {/*
      El brazo. Sus piezas se colocan girando cada una desde el pivote, con los
      mismos ángulos que el tablero; el conjunto gira con `rotate` en `.brazo`, que
      es lo único que el reproductor tendrá que mover.
    */}
    <div class="brazo">
      <div class="brazo-contrapeso-eje">
        <div class="brazo-contrapeso"></div>
      </div>
      <div class="brazo-varilla">
        <div class="brazo-capsula"></div>
      </div>
      <div class="brazo-base"></div>
      <div class="brazo-pivote"></div>
    </div>
  </div>
</div>

<style>
  /*
    Los tamaños del §5.5, como caja + escala de la base de 250 px.

    Van en pares a propósito: CSS todavía no divide una longitud entre otra, así
    que la escala no se puede sacar de la caja. Si se toca uno, se toca el otro
    (escala = caja / 250).

    El ORDEN de los `@media` importa: gana el último que aplique. Primero los de
    escritorio —por ancho y luego por alto, que solo bajan—, y al final los del
    móvil, que pisan a todos.
  */
  .tornamesa {
    --tt-caja: 360px;
    --tt-escala: 1.44;
    position: relative;
    flex-shrink: 0;
    width: var(--tt-caja);
    height: var(--tt-caja);
  }
  /* Corte `amplio` (por debajo de 1600) y hasta 999 px de alto: caja de 300. */
  @media (max-width: 1599px), (max-height: 999px) {
    .tornamesa {
      --tt-caja: 300px;
      --tt-escala: 1.2;
    }
  }
  @media (max-height: 879px) {
    .tornamesa {
      --tt-caja: 240px;
      --tt-escala: 0.96;
    }
  }
  @media (max-height: 759px) {
    .tornamesa {
      --tt-caja: 200px;
      --tt-escala: 0.8;
    }
  }
  /*
    Por debajo del corte `escritorio` la barra ya no mide una pantalla de alto, así
    que los ajustes por alto dejan de tener sentido: en tableta, 240; en el móvil,
    los 150 del bloque «equipo» (§6).
  */
  @media (max-width: 1279px) {
    .tornamesa {
      --tt-caja: 240px;
      --tt-escala: 0.96;
    }
  }
  @media (max-width: 599px) {
    .tornamesa {
      --tt-caja: 150px;
      --tt-escala: 0.6;
    }
  }

  .tornamesa-plato {
    position: absolute;
    left: 0;
    top: 0;
    width: 250px;
    height: 250px;
    transform-origin: 0 0;
    scale: var(--tt-escala);
  }

  /* Los colores de aquí son de la ILUSTRACIÓN —el negro del acetato, los grises
     del metal—, no de la marca, y por eso no son tokens. */
  .vinilo {
    position: absolute;
    inset: 0;
    border-radius: 9999px;
    background-color: #0b0b0b;
    background-image: repeating-radial-gradient(
      circle at 50% 50%,
      #0b0b0b 0px,
      #0b0b0b 2px,
      #1c1c1c 3px,
      #0b0b0b 4px
    );
    box-shadow:
      0 24px 48px rgb(0 0 0 / 0.45),
      0 0 0 1px rgb(255 255 255 / 0.06);
  }
  .vinilo-brillo {
    position: absolute;
    inset: 0;
    border-radius: 9999px;
    background-image: conic-gradient(
      from 20deg,
      rgb(255 255 255 / 0) 0deg,
      rgb(255 255 255 / 0.11) 26deg,
      rgb(255 255 255 / 0) 58deg,
      rgb(255 255 255 / 0) 200deg,
      rgb(255 255 255 / 0.08) 226deg,
      rgb(255 255 255 / 0) 258deg
    );
    pointer-events: none;
  }

  .etiqueta {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 92px;
    height: 92px;
    margin: -46px 0 0 -46px;
    border-radius: 9999px;
    background: var(--color-blanco);
    box-shadow:
      0 0 0 5px #0b0b0b,
      inset 0 0 0 4px var(--color-blanco),
      inset 0 0 0 5px rgb(1 33 105 / 0.35);
  }
  .etiqueta-logo {
    position: absolute;
    left: 14px;
    top: 17px;
    width: 64px;
    height: auto;
  }
  .etiqueta-eje {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 7px;
    height: 7px;
    margin: -3.5px 0 0 -3.5px;
    border-radius: 9999px;
    background: var(--color-azul-principal);
  }
  .etiqueta-frecuencia {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 13px;
    text-align: center;
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 12px;
    line-height: 14px;
    letter-spacing: 1px;
    color: var(--color-azul-principal);
  }

  /*
    El brazo, en REPOSO: `rotate(-4deg)`, apuntando hacia el disco sin tocarlo
    (§5.1). Se usa la propiedad `rotate` y no `transform` para que el día que
    otro gesto necesite mover el brazo no pelee con este (heredado de web-beat, ver
    `scripts/guarda-cascada.mjs`).
  */
  .brazo {
    position: absolute;
    left: 228px;
    top: 22px;
    width: 0;
    height: 0;
    transform-origin: 0 0;
    rotate: -4deg;
  }
  .brazo-contrapeso-eje {
    position: absolute;
    left: 0;
    top: -3px;
    width: 42px;
    height: 6px;
    transform-origin: 0 3px;
    rotate: -73.3deg;
  }
  .brazo-contrapeso {
    position: absolute;
    left: 14px;
    top: -7px;
    width: 24px;
    height: 20px;
    border-radius: 4px;
    background: linear-gradient(90deg, #7d7d7d, #e6e6e6 45%, #8a8a8a);
  }
  .brazo-varilla {
    position: absolute;
    left: 0;
    top: -2.5px;
    width: 193px;
    height: 5px;
    border-radius: 3px;
    background: linear-gradient(180deg, #f4f4f4, #9d9d9d);
    transform-origin: 0 2.5px;
    rotate: 106.7deg;
    box-shadow: 0 8px 14px rgb(0 0 0 / 0.3);
  }
  /* El filo cian de la cápsula es gráfico, que es lo único para lo que el cian
     sirve en este sitio. */
  .brazo-capsula {
    position: absolute;
    right: -10px;
    top: -6px;
    width: 28px;
    height: 17px;
    box-sizing: border-box;
    border-radius: 3px;
    border-top: 3px solid var(--color-logo-cian);
    background: #111111;
    rotate: 24deg;
  }
  .brazo-base {
    position: absolute;
    left: -16px;
    top: -16px;
    width: 32px;
    height: 32px;
    border-radius: 9999px;
    background: radial-gradient(circle at 35% 35%, #fafafa, #9a9a9a 70%);
    box-shadow: 0 5px 12px rgb(0 0 0 / 0.35);
  }
  .brazo-pivote {
    position: absolute;
    left: -5px;
    top: -5px;
    width: 10px;
    height: 10px;
    border-radius: 9999px;
    background: var(--color-marino);
  }
</style>
