---
import Card from '../layouts/CardMoreNews.astro';


const res = await fetch("https://stereociendigital.com.mx/wp-json/wp/v2/posts?_embed&per_page=4&_fields=title,slug,yoast_head_json,categories&categories=527");
const posts = await res.json();

---
<div class="my-12 mx-auto">
	<h5 class="font-bold">Te podría interesar...</h4>
        <section class="flex flex-wrap -mx-1 lg:-mx-4">
                    {
                        posts.map((post:any) => ( 
                        <>
                        <Card {post} />
                        </>
                        ))
                    }
        </section>
<div class="m-auto text-center">
    <a href="/comida-y-guias" class="text-black hover:text-white">
        <button class="ver-mas lovelo group relative h-8 w-36 m-4 overflow-hidden bg-white hover:bg-[#ef4444] uppercase text-xs font-bold tracking-[3px]">
            <span>Más</span>
        </button>
    </a>
</div>
</div>
