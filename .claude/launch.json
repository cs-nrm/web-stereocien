{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "stereocien-v2",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "dev",
        "--port",
        "4331"
      ],
      "port": 4331
    },
    {
      "name": "design",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "4399",
        "--directory",
        "design/stereo-cien-home-handoff"
      ],
      "port": 4399
    },
    {
      "name": "stereocien-v2-build",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "set -a; . ./.env; set +a; PORT=4332 node ./dist/server/entry.mjs"
      ],
      "port": 4332
    }
  ]
}
