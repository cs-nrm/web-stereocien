dist/
# generated types
.astro/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Variables de entorno. En el sitio viejo el `.env` de la raíz estaba VERSIONADO
# (sigue en la rama `stereocien`). Ahí solo había un PUBLIC_API_URL —la URL pública
# del WordPress, no un secreto—, así que no hubo fuga; pero este sitio va a llevar
# config de servidor de verdad (CMS_URL puede ser una IP privada), y el repo es
# público, así que se cierra desde el primer commit.
.env
.env.*
!.env.example

# macOS-specific files
.DS_Store

# Lienzo de Claude Design: el ZIP original no se versiona (pesa y es un artefacto
# de descarga). Sí se versiona la carpeta extraída del lienzo.
design/*.zip
